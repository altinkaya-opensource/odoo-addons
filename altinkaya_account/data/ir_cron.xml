<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_recompute_statement_balances" model="ir.cron">
        <field name="name">Refresh Partner Statement Balances</field>
        <field name="model_id" ref="base.model_res_partner" />
        <field name="state">code</field>
        <field name="code">model._cron_recompute_statement_balances()</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <!-- ir.cron stores UTC: 05:00 UTC is 08:00 in Turkey. -->
        <field
            name="nextcall"
            eval="(DateTime.utcnow() + timedelta(days=1)).strftime('%Y-%m-%d 05:00:00')"
        />
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
    </record>
</odoo>
