<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="view_account_account_reconcile_form" model="ir.ui.view">
        <field name="name">account.account.reoncile.form</field>
        <field name="model">account.account.reconcile</field>
        <field name="inherit_id" ref="account_reconcile_oca.account_account_reconcile_form_view" />
        <field name="arch" type="xml">

            <field name="reconcile_data_info" position="after">

                <div>
                    <field name="manual_model_id" widget="selection_badge_uncheck" nolabel="1" attrs="{'invisible': [('is_reconciled', '=', True)]}" />
                </div>
            </field>

        </field>
    </record>

</odoo>
