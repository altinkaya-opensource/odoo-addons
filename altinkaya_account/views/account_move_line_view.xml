<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_account_move_line_reconcile_tree" model="ir.ui.view">
        <field name="name">account.move.line.reconcile.tree</field>
        <field name="model">account.move.line</field>
        <field
            name="inherit_id"
            ref="account_reconcile_oca.account_move_line_tree_reconcile_view"
        />
        <field name="arch" type="xml">
            <field name="company_currency_id" position="after">
                <field name="journal_code" invisible="1" />
            </field>
        </field>
    </record>

    <record id="view_move_line_tree_currency_editable" model="ir.ui.view">
        <field name="name">account.move.line.tree.currency.editable</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account.view_move_line_tree" />
        <field name="priority">9999</field>
        <field name="arch" type="xml">
            <tree position="attributes">
                <attribute name="editable">bottom</attribute>
            </tree>
            <field name="currency_id" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="invisible">0</attribute>
                <attribute name="attrs">{}</attribute>
            </field>
            <field name="amount_currency" position="attributes">
                <attribute name="readonly">0</attribute>
                <attribute name="force_save">1</attribute>
            </field>
        </field>
    </record>
</odoo>
