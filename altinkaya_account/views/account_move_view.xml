<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record model="ir.ui.view" id="account_move_total_balance">
        <field name="name">account.move.total.balance</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <field name="fiscal_position_id" position="after">
                <field name="total_balance" string="Total Balance" />
            </field>

            <field name="partner_shipping_id" position="attributes">
                <attribute name="attrs">{'invisible': 1}</attribute>
            </field>
            <xpath expr="//label[@for='partner_id']" position="before">
                <field name="carrier_id"/>
                <field name="address_contact_id" string="Teslimat Adresi" context="{'show_address': 1}" options="{'always_reload': True}" />
            </xpath>

            <xpath expr="//field[@name='narration']" position="replace">
                <group string="Notes">
                    <field name="narration"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='invoice_date']" position="after">
                <field name="supplier_invoice_number" attrs="{'invisible': [('move_type','=','out_invoice')]}"></field>
            </xpath>

            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="fiscal_position_id" options="{'no_create': True}"/>
                <field name="total_balance" string="Total Balance"/>
            </xpath>

            <xpath expr="/form/sheet/notebook/page[@name='other_info']" position="after">
                <page string="Payments">
                    <field name="payment_ids">
                        <tree string="Payments">
                            <field name="date" string="Payment Date"/>
                            <field name="move_id"/>
                            <field name="ref"/>
                            <field name="name"/>
                            <field name="journal_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="amount_total" currency_field="currency_id"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
