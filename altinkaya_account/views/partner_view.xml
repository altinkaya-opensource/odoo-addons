<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="act_res_partner_2_account_move_line" model="ir.actions.act_window">
        <field name="name">Yevmiye Kalemleri</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{}</field>
        <field name="domain">
                [('partner_id', '=', active_id), ('account_id.account_type', 'in', ['asset_receivable', 'liability_payable']), ('parent_state', '!=', 'cancel')]
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <field name="vat" position="before">
                <field string="Tax Office Name" name="tax_office_name" />
            </field>

            <xpath expr="//field[@name='property_account_payable_id']" position="after">
                <field
                    name="accounting_contact"
                    domain="[('parent_id', '=', active_id)]"
                />
                <field
                    name="purchase_default_account_id"
                    string="Satınalma Masraf Hesabı"
                />
                <field name="z_payable_export" />
                <field name="z_receivable_export" />
                <field name="partner_currency_id" />
                <field name="balance" />
                <field name="currency_balance" />
                <field name="has_2breconciled_customer" />
                <field name="has_2breconciled_supplier" />
            </xpath>

            <button name="action_view_partner_invoices" position="after">
                <button
                    class="oe_stat_button"
                    type="action"
                    name="%(act_res_partner_2_account_move_line)d"
                    icon="fa-book"
                    string="Yevmiye Kalemleri"
                />
            </button>

            <page name="accounting" position="inside">
                <group string="Kur Farkı" colspan="2" col="2">
                    <group>
                        <field name="currency_difference_checked" />
                        <button
                            name="action_generate_currency_diff_invoice"
                            type="object"
                            string="Kur Farkı Faturası Oluştur"
                            attrs="{'invisible': [('parent_id','!=',False)]}"
                            options="{}"
                        />
                    </group>
                </group>
            </page>
        </field>
    </record>

    <record id="account_res_partner_search_inherit" model="ir.ui.view">
        <field name="name">account.res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="account.res_partner_view_search" />
        <field name="arch" type="xml">
            <filter name="customer" position="attributes">
                <attribute name="string">Customers</attribute>
            </filter>

            <filter name="supplier" position="attributes">
                <attribute name="string">Suppliers</attribute>
            </filter>
        </field>
    </record>

    <record id="account.res_partner_action_customer" model="ir.actions.act_window">
        <field name="view_mode">tree,form,kanban,activity</field>
        <field
            name="context"
        >{'search_default_type_company': 1, 'search_default_customer': 1,'res_partner_search_mode': 'customer', 'default_is_company': True, 'default_customer_rank': 1}</field>
    </record>

    <record id="account.res_partner_action_supplier" model="ir.actions.act_window">
        <field name="view_mode">tree,form,kanban,activity</field>
        <field
            name="context"
        >{'search_default_type_company': 1, 'search_default_supplier': 1,'res_partner_search_mode': 'supplier', 'default_is_company': True, 'default_supplier_rank': 1}</field>
    </record>

    <record id="res_partner_form_view_cari" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.cari</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='risk_limits']" position="attributes">
                <attribute name="string">Özel Limitler</attribute>
            </xpath>
        </field>
    </record>

    <record id="base_res_partner_search_inherit" model="ir.ui.view">
        <field name="name">base.res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='inactive']" position="after">
                <separator />
                <filter
                    name="not_zero"
                    string="Sıfır Değil"
                    domain="['|','|','|',('currency_balance','&gt;',1),('currency_balance','&lt;',-1),('balance','&gt;',10),('balance','&lt;',-10)]"
                />
                <separator />
                <filter
                    name="turkey"
                    string="Türkiye"
                    domain="[('country_id.id','=',224)]"
                />
                <filter
                    name="not_turkey"
                    string="Yurtdışı"
                    domain="[('country_id.id','!=',224)]"
                />
                <separator />
                <filter string="Create Date" name="create_date" date="create_date" />
            </xpath>
        </field>
    </record>

    <record id="res_partner_balance_tree" model="ir.ui.view">
        <field name="name">res.partner.balance.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree>
                <field name="display_name" string="Name" />
                <field name="function" invisible="1" />
                <field name="phone" class="o_force_ltr" />
                <field name="risk_total" string="Risk" />
                <field name="credit_limit" string="Limit" />
                <field name="risk_currency_id" string="Limit Para B." />
                <field
                    name="balance"
                    string="₺ Bakiye"
                    sum="TL Bakiye"
                    widget="monetary"
                />
                <field
                    name="balance_due"
                    string="₺ V.Gelen"
                    sum="TL Vade Gelen"
                    widget="monetary"
                />
                <field
                    name="currency_balance"
                    string="$₺€ Bakiye"
                    sum="Döviz Bakiye"
                    widget="monetary"
                    options="{'currency_field': 'partner_currency_id','digits': 'invoice'}"
                />
                <field
                    name="currency_balance_due"
                    string="$₺€ V.Gelen"
                    sum="Döviz Vade Gelen"
                    widget="monetary"
                    options="{'currency_field': 'partner_currency_id','digits': 'invoice'}"
                />
                <field name="partner_currency_id" string="$€₺" />
                <field name="currency_id" invisible="1" />
                <field name="property_payment_term_id" string="Ödeme Şekli" />
                <field name="email" invisible="1" />
                <field name="user_id" />
                <field name="is_company" invisible="1" />
                <field name="country_id" invisible="1" />
                <field name="parent_id" invisible="1" />
                <field name="active" invisible="1" />
            </tree>
        </field>
    </record>

    <record id="action_partner_balance" model="ir.actions.act_window">
        <field name="name">Partner Balance Action</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">tree,form</field>
        <field
            name="context"
        >{'search_default_customer':1, 'search_default_type_company': 1}</field>
        <field name="view_id" ref="res_partner_balance_tree" />
    </record>

    <menuitem
        id="menu_res_partner_balance_sale"
        name="Borç / Alacak Listesi"
        action="action_partner_balance"
        parent="sale.sale_order_menu"
    />

    <menuitem
        id="menu_res_partner_balance_account"
        name="Borç / Alacak Listesi"
        action="action_partner_balance"
        parent="account.menu_finance_reports"
    />
</odoo>
