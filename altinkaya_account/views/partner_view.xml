<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

    <record id="act_res_partner_2_account_move_line" model="ir.actions.act_window">
        <field name="name">Yevmiye Kalemleri</field>
        <field name="res_model">account.move.line</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="context">{}</field>
        <field name="domain">
                [('partner_id', '=', active_id), ('account_id.account_type', 'in', ['asset_receivable', 'liability_payable'])]
        </field>
    </record>

    <record id="view_partner_form" model="ir.ui.view">
        <field name="name">res.partner.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='tax_office_name']" position="replace"/>
            <field name="vat" position="before">
                <field string="Tax Office" name="tax_office_name" />
            </field>

            <xpath expr="//field[@name='property_account_payable_id']" position="after">
                <field name="accounting_contact" domain="[('parent_id', '=', active_id)]"/>
                <field name="purchase_default_account_id"/>
                <field name="z_payable_export"/>
                <field name="z_receivable_export"/>
                <field name="devir_yapildi"/>
            </xpath>

            <button name="action_view_sale_order" position="after">
                <button class="oe_stat_button" type="action" name="%(act_res_partner_2_account_move_line)d" icon="fa-book" string="Yevmiye Kalemleri">
                </button>
            </button>

        </field>
    </record>



</odoo>
