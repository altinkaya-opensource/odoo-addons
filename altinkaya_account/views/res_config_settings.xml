<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="arch" type="xml">
            <xpath expr="//div[@id='default_accounts']//div[@class='o_setting_right_pane']" position="inside">
                <div class="row mt8">
                    <label for="currency_diff_inv_account_id" class="col-lg-4 o_light_label"/>
                    <field name="currency_diff_inv_account_id"/>
                </div>
            </xpath>
        </field>
    </record>



</odoo>
