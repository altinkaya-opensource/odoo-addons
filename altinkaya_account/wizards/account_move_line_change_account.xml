<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="account_move_line_change_account_view_form" model="ir.ui.view">
        <field name="name">account.move.line.change.account.form</field>
        <field name="model">account.move.line.change.account</field>
        <field name="arch" type="xml">
            <form string="Change Account">
                <group>
                    <field name="account_id" options="{'no_create': True}" />
                </group>
                <field name="line_ids" readonly="1">
                    <tree>
                        <field name="date" />
                        <field name="move_id" />
                        <field name="partner_id" />
                        <field name="account_id" />
                        <field name="debit" sum="Total Debit" />
                        <field name="credit" sum="Total Credit" />
                        <field name="amount_currency" />
                        <field name="currency_id" />
                        <field name="company_currency_id" invisible="1" />
                    </tree>
                </field>
                <footer>
                    <button
                        string="Change Account"
                        name="action_change_account"
                        type="object"
                        default_focus="1"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_account_move_line_change_account" model="ir.actions.act_window">
        <field name="name">Change Account</field>
        <field name="res_model">account.move.line.change.account</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="account.model_account_move_line" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_user'))]" />
    </record>
</odoo>
