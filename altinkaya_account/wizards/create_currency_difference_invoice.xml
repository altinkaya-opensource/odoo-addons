<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_create_difference_inv" model="ir.ui.view">
        <field name="name">create.difference.inv.res.partner</field>
        <field name="model">create.currency.difference.invoice</field>
        <field name="arch" type="xml">
            <form string="Create Difference Invoices">
                <p>This action will create an invoice for every selected partner.</p>
                <group>
                    <field name="invoice_date" />
                    <field name="payment_term_id" />
                    <field name="billing_point_id" />
                </group>
                <footer>
                    <button
                        string="Create Invoices"
                        name="create_invoices"
                        type="object"
                        default_focus="1"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record
        id="action_res_partner_create_currency_invoices"
        model="ir.actions.act_window"
    >
        <field name="name">Create Currency Difference Invoices</field>
        <field name="res_model">create.currency.difference.invoice</field>
        <field name="view_mode">form</field>
        <field name="binding_model_id" ref="base.model_res_partner" />
        <field name="binding_view_types">list</field>
        <field name="groups_id" eval="[(4, ref('account.group_account_invoice'))]" />
        <field name="target">new</field>
    </record>

    <record id="selected_currency_difference_invoice_form" model="ir.ui.view">
        <field name="name">create.selected.currency.difference.invoice.form</field>
        <field name="model">create.selected.currency.difference.invoice</field>
        <field name="arch" type="xml">
            <form string="Create Currency Difference Invoice">
                <group>
                    <group>
                        <field name="partner_id" />
                        <field name="company_id" invisible="1" />
                        <field name="company_currency_id" invisible="1" />
                    </group>
                    <group>
                        <field name="invoice_date" />
                        <field name="payment_term_id" />
                        <field name="billing_point_id" />
                    </group>
                </group>
                <notebook>
                    <page name="invoices" string="Invoices">
                        <p
                        >Eligible invoices are preselected. Adjust the selection if needed.</p>
                        <field
                            name="invoice_ids"
                            nolabel="1"
                            options="{'no_create': True, 'no_open': True}"
                            domain="[('company_id', '=', company_id), ('commercial_partner_id', '=', partner_id), ('state', '=', 'posted'), ('move_type', '=', 'out_invoice'), ('journal_id.code', '!=', 'KFARK'), ('invoice_date', '&gt;=', '2022-01-01'), ('invoice_date', '&lt;=', invoice_date), ('line_ids.account_id.account_type', '=', 'asset_receivable'), ('line_ids.account_id.currency_id', '!=', False)]"
                        >
                            <tree>
                                <field name="invoice_date" />
                                <field name="name" />
                                <field name="currency_id" />
                                <field name="amount_total" />
                                <field name="amount_residual" />
                                <field name="payment_state" />
                            </tree>
                        </field>
                    </page>
                    <page name="payments" string="Payments">
                        <p
                        >Eligible payments are preselected. Adjust the selection if needed.</p>
                        <field
                            name="payment_line_ids"
                            nolabel="1"
                            options="{'no_create': True, 'no_open': True}"
                            domain="[('company_id', '=', company_id), ('partner_id', 'child_of', partner_id), ('parent_state', '=', 'posted'), ('account_id.account_type', '=', 'asset_receivable'), ('account_id.currency_id', '!=', False), ('credit', '&gt;', 0), ('date', '&gt;=', '2022-01-01'), ('date', '&lt;=', invoice_date), ('journal_id.code', 'not in', ('ADVR', 'KFARK', 'KRDGR', 'KRFRK')), '|', ('payment_id', '!=', False), ('statement_line_id', '!=', False)]"
                        >
                            <tree>
                                <field name="date" />
                                <field name="move_id" />
                                <field name="journal_id" />
                                <field name="account_id" />
                                <field name="currency_id" />
                                <field name="amount_currency" />
                                <field name="amount_residual_currency" />
                                <field name="balance" />
                            </tree>
                        </field>
                    </page>
                </notebook>
                <footer>
                    <button
                        string="Create Invoice"
                        name="action_create_invoice"
                        type="object"
                        default_focus="1"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>
