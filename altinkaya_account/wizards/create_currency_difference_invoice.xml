<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

        <record id="res_partner_create_difference_inv" model="ir.ui.view">
            <field name="name">create.difference.inv.res.partner</field>
            <field name="model">create.currency.difference.invoice</field>
            <field name="arch" type="xml">
                <form string="Create Difference Invoices">
                    <p
        >This action will create an invoice for every selected partner.</p>
                    <group>
                        <field name="invoice_date" />
                        <field name="payment_term_id" />
                        <field name="billing_point_id" />
                    </group>
                    <footer>
                        <button
            string="Create Invoices"
            name="create_invoices"
            type="object"
            default_focus="1"
            class="btn-primary"
          />
                        <button
            string="Cancel"
            class="btn-secondary"
            special="cancel"
          />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_res_partner_create_currency_invoices" model="ir.actions.act_window">
            <field name="name">Create Currency Difference Invoices</field>
            <field name="res_model">create.currency.difference.invoice</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="base.model_res_partner" />
            <field name="target">new</field>
        </record>

</odoo>
