<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_accrual_upload_wizard_form" model="ir.ui.view">
        <field name="name">account.accrual.upload.wizard.form</field>
        <field name="model">account.accrual.upload.wizard</field>
        <field name="arch" type="xml">
            <form string="Upload Accrual (.xlsx)" create="false" edit="false">
                <sheet>
                    <group>
                        <field name="data_file" filename="filename" />
                        <field name="filename" readonly="1" />
                    </group>
                    <group>
                        <field name="journal_id" />
                        <field name="currency_id" readonly="1" />
                    </group>
                </sheet>
                <footer>
                    <button
                        string="Import"
                        type="object"
                        name="action_import"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_accrual_upload_wizard" model="ir.actions.act_window">
        <field name="name">Upload Fee Accrual</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">account.accrual.upload.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_accrual_upload_wizard_form" />
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_accrual_upload_root"
        name="Upload Fee Accrual"
        parent="account.menu_finance_entries"
        action="action_accrual_upload_wizard"
        sequence="95"
    />
</odoo>
