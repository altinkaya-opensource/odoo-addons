<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="crm_lead_filter_inherit_altinkaya" model="ir.ui.view">
        <field name="name">crm.lead.activities.filter.inherit</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.view_crm_case_opportunities_filter" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='assigned_to_me']" position="after">
                <filter
                    string="My Team Activities"
                    name="activities_my_team"
                    domain="[('my_team_activity', '=', True)]"
                />
            </xpath>
        </field>
    </record>
    <record id="crm_lead_view_form_inherit_altinkaya" model="ir.ui.view">
        <field name="name">crm.crm_lead_view_form</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form" />
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='lead_partner']/field[@name='partner_id']"
                position="after"
            >
                <field name="linkedin" widget="url" />
            </xpath>
            <xpath
                expr="//group[@name='opportunity_partner']/field[@name='partner_id']"
                position="after"
            >
                <field name="linkedin" widget="url" />
            </xpath>
            <xpath expr="//field[@name='expected_revenue']" position="attributes">
                <attribute name="options">{'currency_field': 'currency_id'}</attribute>
            </xpath>
            <xpath expr="//field[@name='expected_revenue']" position="after">
                <field
                    name="currency_id"
                    class="oe_inline o_input_6ch"
                    options="{'no_create': True, 'no_open': True}"
                />
            </xpath>
        </field>
    </record>
    <record id="crm_case_kanban_view_leads_inherit_altinkaya" model="ir.ui.view">
        <field name="name">crm.lead.kanban.inherit.altinkaya</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_case_kanban_view_leads" />
        <field name="arch" type="xml">
            <xpath expr="//kanban/field[@name='expected_revenue']" position="after">
                <field name="expected_revenue_usd" />
                <field name="currency_id" />
            </xpath>
            <xpath expr="//kanban/progressbar" position="attributes">
                <attribute name="sum_field">expected_revenue_usd</attribute>
            </xpath>
            <xpath
                expr="//templates//field[@name='expected_revenue']"
                position="attributes"
            >
                <attribute name="options">{'currency_field': 'currency_id'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
