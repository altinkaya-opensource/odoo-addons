<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="sale_order_search_inherit_sale_altinkaya" model="ir.ui.view">
        <field name="name">sale.order.search.inherit.sale</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.sale_order_view_search_inherit_sale" />
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='my_sale_orders_filter']" position="after">
                <filter
                    string="My Team"
                    name="my_team"
                    domain="[('my_team', '=', 'user_id.team_id')]"
                />
            </xpath>
        </field>
    </record>
    <record id="sale_order_form_inherit_crm_altinkaya" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.crm.altinkaya</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//header/field[@name='state']" position="before">
                <field name="opportunity_id" invisible="1" />
                <button
                    name="action_create_crm_opportunity"
                    string="Create Opportunity"
                    type="object"
                    attrs="{'invisible': ['|', ('opportunity_id', '!=', False), ('state', 'not in', ['draft', 'sent'])]}"
                />
            </xpath>
            <xpath expr="//div[@name='button_box']" position="inside">
                <button
                    name="action_create_crm_opportunity"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-star"
                    attrs="{'invisible': [('opportunity_id', '=', False)]}"
                >
                    <div class="o_stat_info">
                        <span class="o_stat_text">Opportunity</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
