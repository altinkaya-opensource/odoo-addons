<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="product_mold_maintenance_page" model="ir.ui.view">
        <field name="name">product.mold.maintenance.page</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//form//notebook" position="inside">
                <page
                    string="Maintenance Log"
                    attrs="{'invisible': [('is_mold', '=', False)]}"
                >
                    <field name="is_mold" invisible="1" />
                    <field name="mold_maintenance_log_ids" readonly="1">
                        <tree>
                            <field name="create_date" />
                            <field name="create_uid" />
                            <field name="note" />
                            <field
                                name="photo"
                                widget="image"
                                options="{'size': [50, 50]}"
                            />
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_mold_maintenance_log_tree" model="ir.ui.view">
        <field name="name">mold.maintenance.log.tree</field>
        <field name="model">mold.maintenance.log</field>
        <field name="arch" type="xml">
            <tree>
                <field name="create_date" />
                <field name="create_uid" />
                <field name="product_id" />
                <field name="note" />
                <field name="photo" widget="image" options="{'size': [50, 50]}" />
            </tree>
        </field>
    </record>

    <record id="view_mold_maintenance_log_form" model="ir.ui.view">
        <field name="name">mold.maintenance.log.form</field>
        <field name="model">mold.maintenance.log</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="product_id" />
                        <field name="create_date" readonly="1" />
                        <field name="create_uid" readonly="1" />
                    </group>
                    <group>
                        <field name="note" />
                        <field name="photo" widget="image" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_mold_maintenance_log" model="ir.actions.act_window">
        <field name="name">Mold Maintenance Logs</field>
        <field name="res_model">mold.maintenance.log</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'group_by': ['product_id']}</field>
    </record>

    <menuitem
        id="menu_mold_maintenance_log"
        name="Mold Maintenance Logs"
        parent="mrp.menu_mrp_reporting"
        action="action_mold_maintenance_log"
        sequence="80"
    />
</odoo>
