<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <menuitem
        id="menu_product_category_on_mrp"
        action="product.product_category_action_form"
        name="Product Categories"
        parent="mrp.menu_mrp_bom"
        sequence="16"
    />
    <record id="mrp_bom_line_view_tree" model="ir.ui.view">
        <field name="name">mrp.bom.line.tree</field>
        <field name="model">mrp.bom.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="bom_product_id" optional="show" />
                <field
                    name="parent_product_tmpl_id"
                    string="Product Template"
                    optional="hide"
                />
                <field name="bom_product_qty" optional="hide" />
                <field
                    name="bom_product_uom_id"
                    groups="uom.group_uom"
                    optional="hide"
                />
                <field name="bom_code" optional="hide" />
                <field name="bom_routing_id" optional="hide" />
                <field name="bom_tool_product_id" optional="hide" />
                <field name="bom_type" optional="hide" />
                <field name="bom_checked" optional="hide" />
                <field name="product_id" />
                <field name="product_qty" />
                <field name="product_uom_id" groups="uom.group_uom" />
                <field
                    name="operation_id"
                    groups="mrp.group_mrp_routings"
                    optional="show"
                />
                <field name="manual_consumption" optional="show" />
            </tree>
        </field>
    </record>
    <data>
        <record id="mrp_bom_form_inherit_parameter" model="ir.ui.view">
            <field name="inherit_id" ref="mrp.mrp_bom_form_view" />
            <field name="name">mrp.bom.form.inherit.parameter</field>
            <field name="model">mrp.bom</field>
            <field name="arch" type="xml">
                <field name="code" position="after">
                    <field name="routing_id" />
                    <field
                        name="tool_product_id"
                        domain="[('categ_id','ilike', 'kalıp')]"
                    />
                </field>
                <field name="type" position="after">
                    <field name="checked" />
                </field>

                <xpath expr="//notebook" position="inside">
                    <page name="wcparameters" string="Workcenter Parameters">
                        <field name="wc_parameter_ids">
                            <tree editable="bottom">
                                <!-- <field name="routing_wc_id" domain="[('process_id','=',parent.process_id)]"/> -->
                                <field name="cycle_nbr" />
                                <field name="hour_nbr" widget="float_time" />
                                <field name="time_start" widget="float_time" />
                                <field name="time_stop" widget="float_time" />
                            </tree>
                        </field>
                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
