<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record
    id="view_production_form_inherit_print_product_label"
    model="ir.ui.view"
  >
            <field name="inherit_id" ref="mrp.mrp_production_form_view" />
            <field name="name">mrp.production.form.inherit.label</field>
            <field name="model">mrp.production</field>
            <field name="type">form</field>
            <field name="priority" eval="100" />
            <field name="arch" type="xml">
                <xpath
        expr="//page[@name='components']/field[@name='move_raw_ids']/tree/field[@name='forecast_availability']"
        position="attributes"
      >
                    <attribute name="widget">uom</attribute>
                    <attribute name="options">{'uom_field': 'product_uom'}</attribute>
                </xpath>
                <xpath expr="//page[@name='components']" position="after">
                    <page name="finished_products" string="Finished Products">
                        <field name="move_finished_ids" nolabel="1" readonly="1">
                            <tree>
                                <field name="product_id" />
                                <field
                name="product_qty"
                widget="uom"
                options="{'uom_field': 'product_uom_id'}"
              />
                                <field name="location_dest_id" />
                                <field name="state" />
                            </tree>
                        </field>
                    </page>
                </xpath>

                <xpath expr="//button/field[@name='product_qty']" position="attributes">
                    <attribute name="widget">uom</attribute>
                    <attribute
          name="options"
        >{'uom_field': 'product_uom_id'}</attribute>
                </xpath>

                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="process_id" />
                </xpath>

                <xpath expr="//button[@name='do_unreserve']" position="after">
                    <button
          name="button_print_prod_order"
          string="Print Production Order"
          type="object"
        />
                </xpath>

                <xpath expr="//button[@name='action_assign']" position="after">
                    <button
          name="action_assign_reserved"
          attrs="{'invisible': ['|', ('state', 'in', ('draft', 'done', 'cancel')), ('reserve_visible', '=', False)]}"
          string="Assign Reserved"
          type="object"
        />
                </xpath>

  <!-- <xpath expr="//button[@name='post_inventory']" position="replace">
<button name="post_inventory" string="Post Inventory" type="object" attrs="{'invisible': [('post_visible', '=', False)]}" ></button>
</xpath> -->

                <xpath expr="//button[@name='do_unreserve']" position="after">
                    <button
          name="action_set_production_started"
          string="Start Production"
          attrs="{'invisible':[('state', 'not in', ['confirmed'])]}"
          type="object"
        />
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button
          class="oe_inline oe_stat_button"
          name="action_print_product_label"
          type="object"
          icon="fa-barcode"
          string="Print Barcode"
        />
                </xpath>
                <xpath expr="//field[@name='user_id']" position="replace" />
                <!-- <xpath expr="//field[@name='location_src_id']" position='replace'/> -->
                <!-- <xpath expr="//field[@name='location_dest_id']" position='replace'/> -->
                <xpath expr="//form//field[@name='product_id']" position='attributes'>
                    <attribute
          name="domain"
        >[('has_production_bom','=',True)]</attribute>
                    <attribute name="class" />
                </xpath>

                <xpath
        expr="//field[@name='components_availability_state']"
        position="before"
      >
                <field name="date_start" />
                <field name="date_finished" />
                <field name="commitment_date" />
                </xpath>

                <xpath expr="//field[@name='process_id']" position="after">
                    <field
          name="partner_id"
          readonly="1"
          attrs="{'invisible': [('partner_id', '=', False)]}"
        />
                    <field name="priority" />
                    <field name="x_note" />
                    <field name="sale_note" />
                </xpath>
                <xpath expr="//field[@name='components_availability']" position="after">
                    <field name="location_src_id" />
                    <field name="location_dest_id" />
                    <field name="sale_id" />
                    <field name="origin" />
                    <field name="procurement_group_id" />
                    <field name="x_makine" />
                    <field name="x_operator" />
                </xpath>

                <!-- <xpath expr="//field[@name='routing_id']" position="attributes">
                    <attribute name="attrs">{'invisible': 1}</attribute>
                </xpath> -->

                <!-- <xpath expr="//field[@name='move_raw_ids']/tree/field[@name='product_id']"
                       position="after">
                    <button name="action_create_procurement" type="object" string="Tedarik"
                            attrs="{'invisible':[('state','in',['waiting','done'])]}"/>
                    <button name="action_make_mts" type="object" string="Stoktan Al"
                            attrs="{'invisible':[('state', 'not in', ['waiting','cancel'])]}"/>
                </xpath> -->
            </field>
        </record>

