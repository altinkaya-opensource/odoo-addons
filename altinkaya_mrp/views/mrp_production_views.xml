        <record id="mrp_production_tree_view_priority" model="ir.ui.view">
        <field name="name">MRP Production Tree View Priority</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_tree_view" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='product_qty']" position="attributes">
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom_id'}</attribute>
            </xpath>
            <field name="date_planned_start" position="after">
                <field name="priority" />
            </field>

            <field name="origin" position="before">
                <field name="process_id" />
            </field>

            <xpath expr="//tree" position="attributes">
                <attribute
          name="default_order"
        >priority desc, date_planned_start desc</attribute>
            </xpath>

        </field>
        </record>

        <record id="mrp_production_search_inherit" model="ir.ui.view">
        <field name="name">Altinkaya MRP Production Search Inherit</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.view_mrp_production_filter" />
        <field name="arch" type="xml">
            <filter name="product" position="after">
                <filter
          string="Makine"
          name="x_makine"
          domain="[]"
          context="{'group_by':'x_makine'}"
        />
                <filter
          string="Operatör"
          name="x_operator"
          domain="[]"
          context="{'group_by':'x_operator'}"
        />
                <filter
          string="Öncelik"
          name="priority"
          domain="[]"
          context="{'group_by':'priority'}"
        />
            </filter>

            <filter name="planning_issues" position="after">
                <separator />
                <filter
          name="lastmonthplanned"
          string="Geçen Ay Bitenler"
          domain="[('date_finished','&gt;=', (context_today() + relativedelta(months=-1)).strftime('%Y-%m-01 00:00:00')), ('date_finished','&lt;=', context_today().strftime('%Y-%m-01 00:00:00'))]"
        />
                <filter
          name="thismonthplanned"
          string="Bu Ay bitenler"
          domain="[('date_finished','&gt;=', context_today().strftime('%Y-%m-01 00:00:00')), ('date_finished','&lt;=', context_today().strftime('%Y-%m-%d'))]"
        />
                <separator />
                <filter
          name="bugun"
          string="Bugün Açılanlar"
          domain="[('create_date','&gt;=',(context_today()+relativedelta(days=0)).strftime('%Y-%m-%d 00:00:00')), ('create_date','&lt;=',(context_today()+relativedelta(days=0)).strftime('%Y-%m-%d 23:59:59'))]"
        />
                <filter
          string="Dün Açılanlar"
          name="yesterday"
          domain="[ ('create_date','&gt;=',(context_today()+relativedelta(days=-1)).strftime('%Y-%m-%d 00:00:00')), ('create_date','&lt;=',(context_today()+relativedelta(days=-1)).strftime('%Y-%m-%d 23:59:59'))]"
        />
                <filter
          string="Son 3 Gün Açılanlar"
          name="threedaydel"
          domain="[('create_date','&gt;=',(context_today()+relativedelta(days=-2)).strftime('%Y-%m-%d 00:00:00')), ('create_date','&lt;=',(context_today()+relativedelta(days=0)).strftime('%Y-%m-%d 23:59:59'))]"
        />
                <filter
          string="Geçen Hafta Açılanlar"
          name="lastweekdel"
          domain="[('create_date','&gt;=',(context_today()+relativedelta(weeks=-1,days=0)).strftime('%Y-%m-%d 00:00:00')), ('create_date','&lt;=',(context_today()+relativedelta(weeks=-1,days=7)).strftime('%Y-%m-%d 23:59:59'))]"
        />
                <separator />
            </filter>
        </field>
        </record>

        <record id="mrp_production_tree_without_route" model="ir.ui.view">
            <field name="name">mrp.production.tree.without.route</field>
            <field name="model">mrp.production</field>
            <field name="arch" type="xml">
                <tree
        decoration-bf="message_needaction==True"
        default_order="priority desc,name asc"
        decoration-danger="date_planned_start&lt;current_date and state not in ('done','cancel')"
        decoration-info="sale_id != False"
        decoration-success="state=='progress'"
        decoration-muted="state in ('done','cancel')"
      >
                    <field name="message_needaction" invisible="1" />
                    <field name="name" />
                    <field name="date_planned_start" />
                    <field name="priority" />
                    <field name="product_id" />
                    <field name="origin" />
                    <field
          name="product_qty"
          sum="Total Qty"
          string="Quantity"
          widget="uom"
          options="{'uom_field':'product_uom_id'}"
        />
                    <field
          name="product_uom_id"
          string="ÖB"
          options="{'no_open':True,'no_create':True}"
          groups="uom.group_uom"
        />
                    <field name="x_makine_kod" string="Makine" />
                    <field name="x_operator" string="Operatör" />
                    <field name="sale_id" string="Sipariş" />
                    <field name="state" />
                </tree>
            </field>
        </record>

