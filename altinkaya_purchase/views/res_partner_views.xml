<?xml version="1.0" encoding="utf-8" ?>
<odoo>
	<record id="res_partner_view_form_altinkaya_purchase" model="ir.ui.view">
            <field name="name">altinkaya.purchase.partner.form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form" />
            <field name="priority" eval="100" />
            <field name="arch" type="xml">
            	<field name="property_supplier_payment_term_id" position="after">
                    <field
          name="property_purchase_pricelist"
        /> <!-- domain="[('list_type_use', '=', 'purchase')]" -->
                </field>
                <field name="purchase_requires_second_approval" position="attributes">
                        <attribute name="string">Satınalma Ikinci Onay</attribute>
                </field>
                <field name="purchase_incoterm_id" position="attributes">
                        <attribute name="string">Teslim Şekli</attribute>
                </field>
                <field name="purchase_incoterm_address_id" position="attributes">
                        <attribute name="string">Teslim Adresi</attribute>
                </field>
                <field name="purchase_transport_mode_id" position="attributes">
                        <attribute name="string">Nakliye Yöntemi</attribute>
                </field>
                <xpath
        expr="//field[@name='property_supplier_payment_term_id']"
        position="before"
      >
                    <field name="supplier" readonly="1" />
               </xpath>
               <xpath expr="//field[@name='purchase_user_id']" position="replace" />
               <xpath expr="//field[@name='purchase_team_id']" position="replace" />
           </field>
      </record>
</odoo>
