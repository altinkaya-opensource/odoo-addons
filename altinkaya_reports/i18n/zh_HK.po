"   </p>\n"
"   <a t-att-href=\"object.survey_url\" style=\"text-decoration:none;background-color:transparent;color: rgb(255, 255, 255); font-size: 13px; background-color: rgb(135, 90, 123); padding: 8px 16px; border-radius: 5px;\">\n"
