<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template
            id="report_mrporder_altinkaya"
            inherit_id="mrp.report_mrporder"
            priority="100"
        >
            <xpath expr="//t[@t-call='web.internal_layout']" position="replace">
                <t t-translation="off">
                    <t t-call="web.basic_layout">
                        <div class="header">
                            <t t-call="altinkaya_reports.report_style" />
                            <div class="ak">
                                <table class="ak-head">
                                    <tbody>
                                        <tr>
                                            <td class="ak-brand">
                                                <svg
                                                    xml:space="preserve"
                                                    width="12mm"
                                                    height="9mm"
                                                    version="1.1"
                                                    style="shape-rendering:geometricPrecision; text-rendering:geometricPrecision; image-rendering:optimizeQuality; fill-rule:evenodd; clip-rule:evenodd"
                                                    viewBox="0 0 1200 900"
                                                ><defs>
                                                        <style type="text/css">
.fil0 {
    fill: #e5097f;
}
                                                        </style>
                                                    </defs>
                                                <g id="Katman_x0020_1">
                                                        <metadata
                                                            id="CorelCorpID_0Corel-Layer"
                                                        />
                                                        <path
                                                            class="fil0"
                                                            d="M688 693c37,18 67,49 86,86 21,-5 107,-30 161,-86 62,-65 71,-131 20,-181 -50,-51 -116,-42 -181,20 -56,54 -80,139 -86,161zm-148 -12l0 0c-11,-19 -55,-96 -53,-174 2,-90 42,-143 114,-143 71,0 112,53 113,143 2,78 -42,156 -53,174 -19,-6 -40,-10 -61,-10 -21,0 -41,4 -60,10zm-114 97l0 0c19,-37 50,-67 87,-86 -6,-21 -30,-106 -86,-161 -65,-62 -131,-71 -181,-20 -51,50 -42,117 20,181 54,56 139,80 160,86zm-344 -772l0 0 1036 0c41,0 74,33 74,74l0 814 -93 0c2,-8 3,-18 3,-27 0,-72 -53,-112 -143,-114 -78,-2 -155,42 -174,53 6,19 10,39 10,60 0,10 -1,19 -2,28l-386 0c-1,-9 -2,-18 -2,-28 0,-21 4,-42 10,-61 -18,-11 -96,-55 -174,-53 -90,1 -143,42 -143,113 0,11 1,20 3,29l-93 0 0 -814c0,-41 33,-74 74,-74z"
                                                        />
                                                    </g>
                                            </svg>
                                            </td>
                                            <td>
                                                <span class="ak-kind">ÜRETİM EMRİ</span>
                                                <span
                                                    t-if="o.priority in ('2', '3')"
                                                    class="ak-flag"
                                                >
                                                    <span t-field="o.priority" />
                                                </span>
                                                <div class="ak-title">
                                                    <span t-field="o.name" />
                                                </div>
                                                <div class="ak-sub">
                                                    <span t-field="o.process_id.name" />
                                                </div>
                                            </td>
                                            <td class="ak-qr">
                                                <img
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(o.env['gs1.digital.link'].build_mo_link(o.name)), 420, 420, 0)"
                                                />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                                <div class="ak-rule" />
                            </div>
                        </div>

                        <div class="page ak">
                            <t t-call="altinkaya_reports.report_style" />
                            <table class="ak-hero">
                                <tbody>
                                    <tr>
                                        <td style="width:110px;">
                                            <div class="ak-hero-qty">
                                                <t
                                                    t-out="o.product_qty"
                                                    t-options-widget="'float'"
                                                    t-options-precision="0 if o.product_qty.is_integer() else 2"
                                                />
                                            </div>
                                            <div class="ak-hero-uom">
                                                <span t-field="o.product_uom_id.name" />
                                            </div>
                                        </td>
                                        <td>
                                            <div class="ak-hero-prod">
                                                <span
                                                    t-field="o.product_id.display_name"
                                                />
                                            </div>
                                        </td>
                                        <td class="ak-hero-qr">
                                            <t t-if="o.product_id.barcode">
                                                <img
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(o.env['gs1.digital.link'].build_product_link(o.product_id.barcode)), 380, 380, 0)"
                                                />
                                                <div class="ak-hero-bc">
                                                    <span
                                                        t-field="o.product_id.barcode"
                                                    />
                                                </div>
                                            </t>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div class="ak-band">İŞ BİLGİLERİ</div>
                            <table class="ak-meta">
                                <thead>
                                    <tr>
                                        <th>MAKİNE ADI</th>
                                        <th>OPERATÖR ADI</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span t-field="o.x_makine" />
                                        </td>
                                        <td>
                                            <span t-field="o.x_operator" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                            <table class="ak-meta" style="margin-top:4px;">
                                <thead>
                                    <tr>
                                        <th>BAŞLAMA TARİH SAAT</th>
                                        <th>BİTİŞ TARİH SAAT</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr>
                                        <td>
                                            <span t-field="o.date_start2" />
                                        </td>
                                        <td>
                                            <span t-field="o.date_finished2" />
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <table class="ak-fill">
                                <tbody>
                                    <tr>
                                        <td>
                                            <div class="ak-fill-lbl">ÜRETİLEN ADET</div>
                                            <div class="ak-fill-line" />
                                            <div
                                                class="ak-fill-note"
                                                t-if="o.bom_id.tool_product_id and o.bom_id.tool_product_id.stock_quant_ids.filtered(lambda sq: sq.location_id.usage == 'internal' and sq.quantity &gt; 0)"
                                            >
                                                <strong>Kalıp Konumu:</strong>
                                                <span
                                                    t-field="o.bom_id.tool_product_id.stock_quant_ids.filtered(lambda sq: sq.location_id.usage == 'internal' and sq.quantity &gt; 0)[0].location_id"
                                                />
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>

                            <div
                                t-if="o.x_note"
                                class="ak-note"
                                style="margin-top:8px;"
                            >
                                <b>NOT</b>
                                <div>
                                    <span t-field="o.x_note" />
                                </div>
                            </div>
                            <div t-if="o.sale_note" class="ak-note">
                                <b>SATIŞ NOTU</b>
                                <div>
                                    <span t-field="o.sale_note" />
                                </div>
                            </div>
                            <div t-if="o.sale_id" class="ak-note">
                                <b>MÜŞTERİ</b>
                                <div>
                                    <span t-field="o.sale_id.partner_id.display_name" />
                                </div>
                            </div>

                            <t t-if="o.move_raw_ids">
                                <div class="ak-band">ÜRETİMDE KULLANILACAK ÜRÜNLER</div>
                                <table class="ak-lines">
                                    <thead>
                                        <tr>
                                            <th style="width:96px;">BARKOD</th>
                                            <th>ÜRÜN</th>
                                            <th
                                                class="text-right"
                                                style="width:80px;"
                                            >MİKTAR</th>
                                            <th style="width:130px;">KAYNAK KONUM</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.move_raw_ids" t-as="line">
                                            <td class="ak-cell-qr">
                                                <img
                                                    t-if="line.product_id.barcode"
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(line.product_id.env['gs1.digital.link'].build_product_link(line.product_id.barcode)), 300, 300, 0)"
                                                />
                                            </td>
                                            <td>
                                                <div
                                                    class="ak-code"
                                                    t-if="line.product_id.default_code"
                                                    t-out="line.product_id.default_code"
                                                />
                                                <div
                                                    class="ak-name"
                                                    t-out="line.product_id.name"
                                                />
                                            </td>
                                            <td class="text-right">
                                                <div class="ak-qty">
                                                    <t
                                                        t-out="line.product_uom_qty"
                                                        t-options-widget="'float'"
                                                        t-options-precision="0 if line.product_uom_qty.is_integer() else 2"
                                                    />
                                                </div>
                                                <!-- No groups= on the UoM: it was
                                                     hidden from anyone outside
                                                     product.group_uom, which is
                                                     most of the shop floor. -->
                                                <div
                                                    class="ak-uom"
                                                    t-out="line.product_uom.name"
                                                />
                                            </td>
                                            <td class="ak-dim">
                                                <span
                                                    t-field="line.location_id.display_name"
                                                />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>

                            <t t-set="routes" t-value="o.get_product_route()" />
                            <t t-if="routes">
                                <div class="ak-band">MAMÜL ÜRÜN ROTASI</div>
                                <table class="ak-lines">
                                    <tbody>
                                        <tr t-foreach="routes" t-as="route">
                                            <td class="ak-cell-qr">
                                                <img
                                                    t-if="route[0] == 'picking'"
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(route[1].env['gs1.digital.link'].build_picking_link(route[1].name)), 300, 300, 0)"
                                                />
                                                <img
                                                    t-if="route[0] == 'production'"
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(route[1].env['gs1.digital.link'].build_mo_link(route[1].name)), 300, 300, 0)"
                                                />
                                                <div
                                                    class="ak-dim"
                                                    style="text-align:center;"
                                                >
                                                    <span
                                                        t-if="route[0] == 'picking'"
                                                        t-field="route[1].picking_type_id"
                                                    />
                                                    <span
                                                        t-if="route[0] == 'production'"
                                                        t-field="route[1].process_id.name"
                                                    />
                                                </div>
                                            </td>
                                            <td>
                                                <div class="ak-route-name">
                                                    <span t-field="route[1].name" />
                                                </div>
                                                <div class="ak-route-flow">
                                                    <t t-if="route[0] == 'picking'">
                                                    <span
                                                        t-field="route[1].move_ids[0].location_id"
                                                    />
                                                    &amp;rarr;
                                                    <span
                                                        t-field="route[1].move_ids[0].location_dest_id"
                                                    />
                                                </t>
                                                    <t t-if="route[0] == 'production'">
                                                    <span
                                                        t-field="route[1].move_dest_ids.location_id"
                                                    />
                                                    &amp;rarr;
                                                    <span
                                                        t-field="route[1].move_dest_ids.location_dest_id"
                                                    />
                                                </t>
                                                </div>
                                                <div class="ak-dim">
                                                    <t
                                                        t-if="route[0] == 'picking' or not o.move_dest_ids.raw_material_production_id"
                                                    >
                                                        <span
                                                            t-field="route[1].partner_id"
                                                        />
                                                    </t>
                                                    <t
                                                        t-if="route[0] == 'production' and o.move_dest_ids.raw_material_production_id"
                                                    >
                                                        <span
                                                            t-field="o.move_dest_ids.raw_material_production_id.product_id.display_name"
                                                        />
                                                    </t>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </t>
                        </div>

                        <div class="footer ak">
                            <t t-call="altinkaya_reports.report_style" />
                            <div class="text-center ak-foot">
                            <span t-field="o.name" />
                            &amp;bull; Yazdıran:
                            <span t-out="user.name" />
                            &amp;bull; Baskı Tarih Saat:
                            <span
                                t-out="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"
                            />
                            &amp;bull; Sayfa
                            <span class="page" />
                            /
                            <span class="topage" />
                        </div>
                        </div>
                    </t>
                </t>
            </xpath>
        </template>
    </data>

    <data noupdate="1">
        <template id="report_mrporder_altinkayaB">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaC">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaD">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaE">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaF">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaG">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaH">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaI">
            <t t-call="mrp.report_mrporder" />
        </template>
        <template id="report_mrporder_altinkayaK">
            <t t-call="mrp.report_mrporder" />
        </template>
    </data>
</odoo>
