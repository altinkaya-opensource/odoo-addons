<?xml version="1.0" encoding="UTF-8" ?>
<!-- noupdate was inherited from the 2019 import and silently froze these
     templates: the live Depo Fişi sat 16 months behind the repo (missing the
     Turkish-rendering fix and the QC inspection QR). Templates are code, not
     user data — they must track the module. -->
<odoo>
    <template
        id="report_picking_altinkaya"
        inherit_id="stock.report_picking"
        priority="100"
    >
        <xpath expr="//t[@t-call='web.html_container']" position="replace">
            <t t-translation="off">
                <t t-foreach="docs" t-as="o">
                    <t t-set="o" t-value="o.with_context(lang='tr_TR')" />
                    <t t-call="web.html_container">
                        <t t-call="web.basic_layout">
                            <!-- Column visibility is decided once and reused by both
                             the header and the body rows. Deriving them
                             separately is what let the two drift apart: a cell
                             could vanish while its header stayed, shifting every
                             column after it. -->
                            <t
                                t-set="show_src"
                                t-value="o.picking_type_id.code != 'incoming'"
                            />
                            <t
                                t-set="show_dest"
                                t-value="o.picking_type_id.code != 'outgoing'"
                            />
                            <t
                                t-set="show_qc"
                                t-value="'draft_inspection_id' in o.move_ids._fields and any(m.draft_inspection_id.qr_image_256 for m in o.move_ids)"
                            />

                            <div class="header">
                                <t t-call="altinkaya_reports.report_style" />
                                <div class="ak">
                                    <table class="ak-head">
                                        <tbody>
                                            <tr>
                                                <td class="ak-brand">
                                                    <svg
                                                        xml:space="preserve"
                                                        width="12mm"
                                                        height="9mm"
                                                        version="1.1"
                                                        style="shape-rendering:geometricPrecision; text-rendering:geometricPrecision; image-rendering:optimizeQuality; fill-rule:evenodd; clip-rule:evenodd"
                                                        viewBox="0 0 1200 900"
                                                    >
                                                    <defs>
                                                            <style
                                                                type="text/css"
                                                            ><![CDATA[ .fil0 {fill:#E5097F}]]></style>
                                                        </defs>
                                                    <g id="Katman_x0020_1">
                                                            <metadata
                                                                id="CorelCorpID_0Corel-Layer"
                                                            />
                                                            <path
                                                                class="fil0"
                                                                d="M688 693c37,18 67,49 86,86 21,-5 107,-30 161,-86 62,-65 71,-131 20,-181 -50,-51 -116,-42 -181,20 -56,54 -80,139 -86,161zm-148 -12l0 0c-11,-19 -55,-96 -53,-174 2,-90 42,-143 114,-143 71,0 112,53 113,143 2,78 -42,156 -53,174 -19,-6 -40,-10 -61,-10 -21,0 -41,4 -60,10zm-114 97l0 0c19,-37 50,-67 87,-86 -6,-21 -30,-106 -86,-161 -65,-62 -131,-71 -181,-20 -51,50 -42,117 20,181 54,56 139,80 160,86zm-344 -772l0 0 1036 0c41,0 74,33 74,74l0 814 -93 0c2,-8 3,-18 3,-27 0,-72 -53,-112 -143,-114 -78,-2 -155,42 -174,53 6,19 10,39 10,60 0,10 -1,19 -2,28l-386 0c-1,-9 -2,-18 -2,-28 0,-21 4,-42 10,-61 -18,-11 -96,-55 -174,-53 -90,1 -143,42 -143,113 0,11 1,20 3,29l-93 0 0 -814c0,-41 33,-74 74,-74z"
                                                            />
                                                        </g>
                                                </svg>
                                                </td>
                                                <td>
                                                    <span
                                                        class="ak-kind"
                                                    >DEPO FİŞİ</span>
                                                    <div class="ak-title">
                                                        <span t-field="o.name" />
                                                    </div>
                                                    <div class="ak-sub">
                                                        <span
                                                            t-field="o.picking_type_id"
                                                        />
                                                    </div>
                                                </td>
                                                <td class="ak-qr">
                                                    <img
                                                        t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(o.env['gs1.digital.link'].build_picking_link(o.name)), 420, 420, 0)"
                                                    />
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                    <div class="ak-rule" />
                                </div>
                            </div>

                            <div class="page ak">
                                <t t-call="altinkaya_reports.report_style" />
                                <!-- Addresses. One block per picking type, same field
                                 set in each. -->
                                <t
                                    t-set="addr_label"
                                    t-value="'TEDARİKÇİ ADRESİ' if o.picking_type_id.code == 'incoming' else ('MÜŞTERİ ADRESİ' if o.picking_type_id.code == 'outgoing' else 'DEPO ADRESİ')"
                                />
                                <div t-if="o.partner_id">
                                    <div class="ak-band">
                                        <t t-out="addr_label" />
                                    </div>
                                    <div class="ak-box">
                                        <div class="ak-party">
                                            <t t-out="o.partner_id.display_name" />
                                        </div>
                                        <div class="ak-addr">
                                            <t t-out="o.partner_id.street" />
                                            <t t-out="o.partner_id.street2" />
                                            <t t-out="o.partner_id.city" />
                                            <t t-out="o.partner_id.state_id.name" />
                                            <t t-out="o.partner_id.country_id.name" />
                                        </div>
                                    </div>
                                </div>

                                <div
                                    t-if="o.move_ids and o.move_ids[0].partner_id and o.move_ids[0].partner_id.id != o.partner_id.id"
                                >
                                    <div class="ak-band">TESLİMAT ADRESİ</div>
                                    <div class="ak-box">
                                        <div class="ak-party">
                                            <t
                                                t-out="o.move_ids[0].partner_id.display_name"
                                            />
                                        </div>
                                        <div class="ak-addr">
                                            <t
                                                t-out="o.move_ids[0].partner_id.street"
                                            />
                                            <t
                                                t-out="o.move_ids[0].partner_id.street2"
                                            />
                                            <t t-out="o.move_ids[0].partner_id.city" />
                                            <t
                                                t-out="o.move_ids[0].partner_id.state_id.name"
                                            />
                                            <t
                                                t-out="o.move_ids[0].partner_id.country_id.name"
                                            />
                                        </div>
                                    </div>
                                </div>

                                <div
                                    t-if="o.picking_type_id.code != 'internal' and (not o.move_ids or not o.move_ids[0].partner_id) and o.picking_type_id.warehouse_id.partner_id"
                                >
                                    <div class="ak-band">DEPO ADRESİ</div>
                                    <div class="ak-box">
                                        <div class="ak-party">
                                            <t
                                                t-out="o.picking_type_id.warehouse_id.partner_id.display_name"
                                            />
                                        </div>
                                        <div class="ak-addr">
                                            <t
                                                t-out="o.picking_type_id.warehouse_id.partner_id.street"
                                            />
                                            <t
                                                t-out="o.picking_type_id.warehouse_id.partner_id.street2"
                                            />
                                            <t
                                                t-out="o.picking_type_id.warehouse_id.partner_id.city"
                                            />
                                            <t
                                                t-out="o.picking_type_id.warehouse_id.partner_id.state_id.name"
                                            />
                                            <t
                                                t-out="o.picking_type_id.warehouse_id.partner_id.country_id.name"
                                            />
                                        </div>
                                    </div>
                                </div>

                                <div class="ak-band">SEVKİYAT BİLGİLERİ</div>
                                <table class="ak-meta">
                                    <thead>
                                        <tr>
                                            <th>SİPARİŞ (KAYNAK)</th>
                                            <th>DURUMU</th>
                                            <th>SORUMLUSU</th>
                                            <th>TARİH</th>
                                            <th>SATIŞ TEMSİLCİSİ</th>
                                            <th
                                                name="td_sched_date_h"
                                            >PLANLANAN TARİH</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>
                                                <span t-field="o.origin" />
                                            </td>
                                            <td>
                                                <span t-field="o.x_durum" />
                                            </td>
                                            <td>
                                                <span t-field="o.hazirlayan" />
                                            </td>
                                            <td>
                                                <span t-field="o.date" />
                                            </td>
                                            <td>
                                                <span t-field="o.sale_id.create_uid" />
                                            </td>
                                            <td name="td_sched_date">
                                                <span t-field="o.scheduled_date" />
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>

                                <div t-if="o.carrier_id" class="ak-note">
                                    <b>NAKLİYECİ</b>
                                    <div>
                                        <span t-field="o.carrier_id" />
                                    </div>
                                </div>
                                <div t-if="o.note" class="ak-note">
                                    <b>NOT</b>
                                    <div>
                                        <span t-field="o.note" />
                                    </div>
                                </div>
                                <div t-if="o.sale_note" class="ak-note">
                                    <b>SATIŞ NOTU</b>
                                    <div>
                                        <span t-field="o.sale_note" />
                                    </div>
                                </div>

                                <div class="ak-band">ÜRÜNLER</div>
                                <table class="ak-lines">
                                    <thead>
                                        <tr>
                                            <th
                                                t-if="show_qc"
                                                style="width:80px;"
                                            >KK</th>
                                            <th>ÜRÜN</th>
                                            <th
                                                class="text-right"
                                                style="width:74px;"
                                            >MİKTAR</th>
                                            <th
                                                t-if="show_src"
                                                style="width:120px;"
                                            >KAYNAK</th>
                                            <th
                                                t-if="show_dest"
                                                style="width:110px;"
                                            >HEDEF</th>
                                            <th style="width:96px;">BARKOD</th>
                                            <th style="width:96px;">REZERVE KONUM</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr t-foreach="o.move_ids" t-as="move">
                                            <!-- Rendered whenever the column exists, so
                                             a move without an inspection leaves a
                                             blank cell instead of shifting the row. -->
                                            <td t-if="show_qc" class="ak-cell-qr">
                                                <img
                                                    t-if="move.draft_inspection_id.qr_image_256"
                                                    t-att-src="image_data_uri(move.draft_inspection_id.qr_image_256)"
                                                    style="width:74px;height:74px;"
                                                />
                                            </td>
                                            <td>
                                                <div
                                                    class="ak-code"
                                                    t-if="move.product_id.default_code"
                                                    t-out="move.product_id.default_code"
                                                />
                                                <div
                                                    class="ak-name"
                                                    t-out="move.product_id.name"
                                                />
                                            </td>
                                            <td class="text-right">
                                                <div class="ak-qty">
                                                    <t
                                                        t-out="move.product_uom_qty"
                                                        t-options-widget="'float'"
                                                        t-options-precision="0 if move.product_uom_qty.is_integer() else 2"
                                                    />
                                                </div>
                                                <div class="ak-uom">
                                                    <span t-field="move.product_uom" />
                                                </div>
                                            </td>
                                            <td t-if="show_src">
                                                <span t-field="move.location_id" />
                                                <div class="ak-dim">
                                                    Stokta:
                                                    <t
                                                    t-out="move.product_id.qty_available"
                                                    t-options-widget="'float'"
                                                    t-options-precision="0 if move.product_id.qty_available.is_integer() else 2"
                                                />
                                                    <span
                                                    t-field="move.product_id.uom_id.name"
                                                />
                                                </div>
                                            </td>
                                            <td t-if="show_dest">
                                                <span t-field="move.location_dest_id" />
                                            </td>
                                            <td class="ak-cell-qr">
                                                <img
                                                    t-if="move.product_id.barcode"
                                                    t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s&amp;quiet=%s' % ('QR', quote_plus(move.product_id.env['gs1.digital.link'].build_product_link(move.product_id.barcode)), 300, 300, 0)"
                                                />
                                            </td>
                                            <td>
                                                <ul
                                                    class="ak-res"
                                                    t-if="move.move_lines_count"
                                                >
                                                    <li
                                                        t-foreach="move.move_line_ids"
                                                        t-as="quant"
                                                    >
                                                    <t
                                                        t-out="quant.location_id.name"
                                                    />:
                                                    <t
                                                        t-out="quant.reserved_uom_qty"
                                                        t-options-widget="'float'"
                                                        t-options-precision="0 if quant.reserved_uom_qty.is_integer() else 2"
                                                    />
                                                </li>
                                                </ul>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>

                            <div class="footer ak">
                                <t t-call="altinkaya_reports.report_style" />
                                <div class="text-center ak-foot">
                                <span t-field="o.name" />
                                &amp;bull; Yazdıran:
                                <span t-field="user.name" />
                                &amp;bull; Tarih:
                                <span
                                    t-out="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y %H:%M')"
                                />
                                &amp;bull; Sayfa
                                <span class="page" />
                                /
                                <span class="topage" />
                            </div>
                            </div>
                        </t>
                    </t>
                </t>
            </t>
        </xpath>
    </template>

    <template id="report_picking_altinkayaB">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>

    <template id="report_picking_altinkayaC">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaD">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaE">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaF">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaG">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaH">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaS">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaO">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
    <template id="report_picking_altinkayaK">
        <t t-call="altinkaya_reports.report_picking_altinkaya" />
    </template>
</odoo>
