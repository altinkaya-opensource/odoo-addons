<odoo>
    <record id="view_res_company_form_inherit" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Report Info" name="report_info">
                    <field name="official_name"/>
                    <field name="multi_lang_logo_ids"/>
                </page>
            </xpath>
        </field>
    </record>

    <record id="view_multi_lang_logo_form" model="ir.ui.view">
        <field name="name">multi.lang.logo.form</field>
        <field name="model">multi.lang.logo</field>
        <field name="arch" type="xml">
            <form string="Multi Lang Logo">
                <sheet>
                    <group>
                        <field name="lang_id"/>
                        <field name="image"/>
                        <field name="company_id" invisible="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_multi_lang_logo_tree" model="ir.ui.view">
        <field name="name">multi.lang.logo.tree</field>
        <field name="model">multi.lang.logo</field>
        <field name="arch" type="xml">
            <tree string="Multi Lang Logos">
                <field name="lang_id"/>
                <field name="image"/>
                <field name="company_id" invisible="1"/>
            </tree>
        </field>
    </record>
</odoo>