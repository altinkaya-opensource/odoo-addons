       <t t-if="object.origin">
            Order reference: <t t-out="object.origin"/><br/>
       </t>
       <t t-if="object.client_order_ref">
            Your reference: <t t-out="object.client_order_ref"/><br/>
        </t>
       <t t-if="object.user_id">
            Prepared By: <a t-att-href="'mailto:%s?subject=Order %s' % (object.user_id.email or '', object.name or '')">
                 <t t-out="object.user_id.name"/>
            </a>
       </t>

    </p>

<t t-if="object.state in ('draft', 'sent')">
