#. module: altinkaya_sales
#: model:mail.template,body_html:altinkaya_sales.email_template_edi_sale_altinkaya1
msgid ""
"<t t-if=\"object.partner_id.lang == 'tr_TR'\">\n"
"                    <div style=\"font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;background-color: #ffffff;\">\n"
"\n"
"                        <p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">Sayın <t t-out=\"object.partner_id.name\"></t>\n"
",</p>\n"
"\n"
"                        <p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"                            <t t-out=\"object.state in ('draft', 'sent') and 'Öncelikle ürünlerimizle ilgilendiğiniz için teşekkür ederiz. İstemiş olduğunuz ürünlerle ilgili fiyat teklifimizi ekte bulabilirsiniz.' or 'Ekte işleme aldığımız siparişinize ait bilgileri içeren sipariş emrini bulabilirsiniz.'\"></t>\n"
"                        </p>\n"
"                        <p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"                            <t t-out=\"object.state in ('draft', 'sent') and 'Teklifimizi işleme alabilmemiz için bu e-postaya teklifimizi onayladığınızı belirten bir cevap gönderebilir ya da teklifimizi onaylayıp bize geri gönderebilirsiniz.' or 'Siparişinizi en kısa sürede hazırlamak için çalışıyoruz.'\"></t>\n"
"                        </p>\n"
"                        <p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"                            <t t-out=\"object.state in ('draft', 'sent') and 'Teklifimizle ' or 'Siparişinizle '\"></t>\n"
"ilgili sormak istediğiniz soruları bu mesaja cevap vererek ya da <strong style=\"box-sizing:border-box;font-weight:bolder;\">0312 3952768</strong> nolu telefonumuzdan bizi arayarak sorabilirsiniz.</p>\n"
"\n"
"                        <p style=\"border-style:none none none solid;box-sizing:border-box;border-left-color:#8e0000;border-left-width:1px;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; border-left: 1px solid #8e0000; margin-left: 30px;\">\n"
"                            <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                                <t t-out=\"object.state in ('draft', 'sent') and 'Teklif' or 'Sipariş'\"></t>\n"
" Detayları</strong>\n"
"                            <br>\n"
"                            <t t-out=\"object.state in ('draft', 'sent') and 'Teklif' or 'Sipariş'\"></t>\n"
" Numarası: <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                            <t t-out=\"object.name\"></t>\n"
"                        </strong>\n"
"                        <br>\n"
"                        <t t-out=\"object.state in ('draft', 'sent') and 'Teklif' or 'Sipariş'\"></t>\n"
" Toplamı: <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"                        <t t-out=\"object.pricelist_id.currency_id.symbol\"></t>\n"
"                        <t t-out=\" '{0:,.2f}'.format(object.amount_total).replace('.','%').replace(',',' ').replace('%',',')\"></t>\n"
"                    </strong>\n"
"                    <br>\n"
"                    <t t-out=\"object.state in ('draft', 'sent') and 'Teklif' or 'Sipariş'\"></t>\n"
" Tarihi: <t t-out=\"'{:%d.%m.%Y %H.%M}'.format(object.date_order)\"></t>\n"
"                <br>\n"
"                <t t-if=\"object.client_order_ref\">\n"
"         Sizin Referansınız: <t t-out=\"object.client_order_ref\"></t>\n"
"                <br>\n"
"            </t>\n"
"            <t t-if=\"object.user_id\">\n"
"                <t t-out=\"object.state in ('draft', 'sent') and 'Teklifi' or 'Siparişi'\"></t>\n"
" Hazırlayan : <a t-attf-href=\"mailto:satis@altinkaya.com?subject=Siparis #{object.name}\" t-esc=\"object.user_id.name\"></a>\n"
"        </t>\n"
"    </p>\n"
"    <t t-if=\"object.state in ('draft', 'sent')\">\n"
"\n"
"\n"
"        <br>\n"
"        <a style=\"margin:0 0 0 120px;box-sizing:border-box;text-decoration:none;background-color:transparent;color: #7c7bad; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; text-decoration-thickness: initial; margin-left: 120px;\" t-attf-href=\"#{object.get_portal_url()}\">\n"
"            <img src=\"https://www.altinkaya.com/web/content/604752?simdiode=1\" class=\"o_we_selected_image\" data-original-title=\"\" style=\"outline-width:3px;outline-style:solid;outline-color:#dfdff4;box-sizing: border-box; outline: #dfdff4 solid 3px; border-style: none; vertical-align: middle; width: 151px; height: 64px;\" width=\"151\" height=\"64\">\n"
"        </a>\n"
"        <br>\n"
"        <p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">Dilerseniz yukarıdaki şimdi öde butonuna tıklayarak ödemenizi web sitemiz üzerinden kredi kartınızla kolay ve güvenli bir şekide yapabilirsiniz:</p>\n"
"        <font color=\"#222222\" face=\"Lucica Grande, Ubuntu, Arial, Verdana, sans-serif\">\n"
"            <span style=\"font-size: 12px;\">YENİ: Havale/EFT açıklamasında </span>\n"
"        </font>\n"
"        <span style=\"color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; font-weight: bolder; font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; text-align: inherit;\">\n"
"            <t t-out=\"object.name\"></t>\n"
"        </span>\n"
"        <span style=\"font-size: 12px; color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\"> sipariş numaranızı belirtirseniz sistemimiz siparişi otomatik onaylar.</span>\n"
"        <div style=\"font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;background-color: #ffffff;\">\n"
"            <font color=\"#222222\" face=\"Lucica Grande, Ubuntu, Arial, Verdana, sans-serif\">\n"
"                <span style=\"font-size: 12px;\"></span>\n"
"            </font>\n"
"            <br>\n"
"        </div>\n"
"    </t>\n"
"    <br>\n"
"    <div style=\"font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; width: 450px; margin: 0px; padding: 0px; background-color: #ab0000; border-top-left-radius: 5px; border-top-right-radius: 5px; background-repeat: repeat-x;\">\n"
"        <h3 style=\"box-sizing: border-box; line-height: 1.2; font-weight: bold; font-family: 'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; margin: 0px; padding: 2px 14px; font-size: 12px; color: #dddddd;\">\n"
"            <strong style=\"box-sizing:border-box;font-weight:bolder;text-transform:uppercase;\">\n"
"                <t t-out=\"object.company_id.name\"></t>\n"
"            </strong>\n"
"        </h3>\n"
"    </div>\n"
"    <div style=\"font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; width: 450px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: #f2f2f2;\">\n"
"        <span style=\"color: #222; margin-bottom: 5px; display: block; \">\n"
"            <t t-if=\"object.company_id.partner_id\">\n"
"                <t t-out=\"object.company_id.partner_id.contact_address\"></t>\n"
"                <br>\n"
"            </t>\n"
"        </span>\n"
"        <t t-if=\"object.company_id.phone\">\n"
"            <div style=\"font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; \">\n"
"                Telefon:  <t t-out=\"object.company_id.phone\"></t>\n"
"   Faks:  <t t-out=\"object.company_id.partner_id.fax\"></t>\n"
"        </div>\n"
"    </t>\n"
"    <t t-if=\"object.company_id.website\">\n"
"        <div style=\"font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;\">\n"
"                Web : \n"
"        <br>\n"
"E-posta : <a t-attf-href=\"mailto:satis@altinkaya.com?subject=Siparis%20#{object.name}\" style=\"text-decoration:none;box-sizing:border-box;background-color:transparent;text-decoration-thickness:initial;color:#7c7bad;\">satis@altinkaya.com</a>\n"
"    </div>\n"
"</t>\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;\"></p>\n"
"</div>\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"<t t-out=\"object.state in ('draft', 'sent') and 'Değerli siparişlerinizi bekler iyi çalışmalar dileriz.' or 'Siparişiniz için teşekkür eder hayırlı işler dileriz.'\"></t>\n"
"</p>\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family: 'Lucida Grande ', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">Aşağıdaki bağlantıdan müşteri deneyiminizi puanlayabilirsiniz.</p>\n"
"<a t-attf-href=\"#{object.survey_url}\" style=\"box-sizing:border-box;text-decoration:none;background-color:transparent;color: #ffffff; font-family:  'Lucica Grande ', Ubuntu, Arial, Verdana, sans-serif; font-size: 13px; background-color: #875a7b; padding: 8px 16px; border-radius: 5px;\">\n"
"                Deneyimi Puanla\n"
"</a>\n"
"\n"
"</div>\n"
"</t>\n"
"\n"
"<t t-else=\"\">\n"
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;background-color: #ffffff;\">\n"
"\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"        Hello, <t t-out=\"object.partner_id.name\"></t>\n"
"</p>\n"
"\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"        Here is your <t t-out=\"object.state in ('draft', 'sent') and 'quotation' or 'order confirmation'\"></t>\n"
" from Altinkaya Enclosures For Electronics:\n"
"</p>\n"
"\n"
"<p style=\"border-style:none none none solid;box-sizing:border-box;border-left-color:#8e0000;border-left-width:1px;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; border-left: 1px solid #8e0000; margin-left: 30px;\">\n"
"<strong style=\"box-sizing:border-box;font-weight:bolder;\">REFERENCES</strong>\n"
"<br>\n"
"         Order number: <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"<t t-out=\"object.name\"></t>\n"
"</strong>\n"
"<br>\n"
"         Order total: <strong style=\"box-sizing:border-box;font-weight:bolder;\">\n"
"<t t-out=\"'{0:,.4f}'.format(object.amount_total).replace('.', '%').replace(',', ' ').replace('%', ',')\"></t>\n"
"<t t-out=\"object.pricelist_id.currency_id.name\"></t>\n"
"</strong>\n"
"<br>\n"
"         Order date: <t t-out=\"object.date_order\"></t>\n"
"<br>\n"
"<t t-if=\"object.client_order_ref\">\n"
"            Your reference: <t t-out=\"object.client_order_ref\"></t>\n"
"<br>\n"
"</t>\n"
"<t t-if=\"object.user_id\">\n"
"         Prepared By: <a t-attf-href=\"mailto:sales@altinkaya.com?subject=Order #{object.name}\" t-esc=\"object.user_id.name\"></a>\n"
"</t>\n"
"</p>\n"
"<t t-if=\"object.state in ('draft', 'sent')\">\n"
"<a t-attf-href=\"#{object.get_portal_url()}\" style=\"margin:0 0 0 120px;box-sizing:border-box;text-decoration:none;background-color:transparent;color: #7c7bad; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; text-decoration-thickness: auto; margin-left: 120px;\">\n"
"<img src=\"https://www.altinkaya.com.tr/web/content/604751?paynow=1\" style=\"box-sizing: border-box; border-style: none; vertical-align: middle; width: 151px; height: 64px;\" width=\"151\" height=\"64\">\n"
"</a>\n"
"<br>\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"            It is also possible to make your payment by clicking \"Pay Now\" button above.  <br>\n"
"Our web page will open and you will be able to make your payment securely and easily.\n"
"</p>\n"
"<font color=\"#222222\" face=\"Lucica Grande, Ubuntu, Arial, Verdana, sans-serif\">\n"
"<span style=\"font-size: 12px;\">NEW: If you mention your order number </span>\n"
"</font>\n"
"<span style=\"color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; font-weight: bolder; font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; text-align: inherit;\">\n"
"<t t-out=\"object.name\"></t>\n"
"</span>\n"
"<span style=\"font-size: 12px; color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\">\n"
"            in the wire transfer/TT description, our system will automatically confirm the order.\n"
"</span>\n"
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;background-color: #ffffff;\">\n"
"<font color=\"#222222\" face=\"Lucica Grande, Ubuntu, Arial, Verdana, sans-serif\">\n"
"<span style=\"font-size: 12px;\">\n"
"</span>\n"
"</font>\n"
"</div>\n"
"</t>\n"
"\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"            If you have any question, do not hesitate to contact us.\n"
"</p>\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"<strong style=\"box-sizing:border-box;font-weight:bolder;\">You can reply this email to contact us.</strong>\n"
"</p>\n"
"\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">\n"
"            Thank you for choosing Altinkaya!\n"
"</p>\n"
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; width: 375px; margin: 0px; padding: 0px; background-color: #8e0000; border-top-left-radius: 5px; border-top-right-radius: 5px; background-repeat: repeat-x;\">\n"
"<h3 style=\"box-sizing: border-box; line-height: 1.2; font-weight: bold; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; margin: 0px; padding: 2px 14px; font-size: 12px; color: #dddddd;\">\n"
"<strong style=\"box-sizing:border-box;font-weight:bolder;text-transform:uppercase;\">ALTINKAYA ENCLOSURES FOR ELECTRONICS</strong>\n"
"</h3>\n"
"</div>\n"
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; width: 347px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: #f2f2f2;\">\n"
"<t t-if=\"object.company_id.street\">\n"
"<t t-out=\"object.company_id.street\"></t>\n"
"<br>\n"
"</t>\n"
"<t t-if=\"object.company_id.street2\">\n"
"<t t-out=\"object.company_id.street2\"></t>\n"
"<br>\n"
"</t>\n"
"<t t-if=\"object.company_id.city or object.company_id.zip\">\n"
"<t t-out=\"object.company_id.zip\"></t>\n"
"<t t-out=\"object.company_id.city\"></t>\n"
"<br>\n"
"</t>\n"
"<t t-if=\"object.company_id.country_id\">\n"
"<t t-out=\"object.company_id.state_id and ('%s, ' % object.company_id.state_id.name) or ''\"></t>\n"
" Turkey <br>\n"
"</t>\n"
"<t t-if=\"object.company_id.phone\">\n"
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; \">\n"
"                    Phone:  <t t-out=\"object.company_id.phone\"></t>\n"
"<br>\n"
"Fax  :  <t t-out=\"object.company_id.partner_id.fax\"></t>\n"
"</div>\n"
"</t>\n"
"<t t-if=\"object.company_id.website\">\n"
"<div style=\"font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"                    Web : <a href=\"http://www.altinkaya.com\" style=\"text-decoration:none;box-sizing:border-box;background-color:transparent;text-decoration-thickness:auto;color:#7c7bad;\">www.altinkaya.com</a>\n"
"</div>\n"
"</t>\n"
"</div>\n"
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;color: #222222; font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; margin-top: 15px;\">\n"
