#. module: altinkaya_sales
#: model:mail.template,body_html:altinkaya_sales.email_template_edi_sale_altinkaya
msgid ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;background-color: rgb(255, 255, 255);\">\n"
"\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">Hello, <t t-out=\"object.partner_id.name\"></t></p>\n"
"    \n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">Here is your <t t-out=\"object.state in (&#x27;draft&#x27;, &#x27;sent&#x27;) and &#x27;quotation&#x27; or &#x27;order confirmation&#x27;\"></t> from Altinkaya Enclosures For Electronics: </p>\n"
"\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; border-left: 1px solid rgb(142, 0, 0); margin-left: 30px;\">\n"
"         <strong style=\"font-weight:bolder;\">REFERENCES</strong><br/>\n"
"         Order number: <strong style=\"font-weight:bolder;\"><t t-out=\"object.name\"></t></strong><br/>\n"
"         Order total: <strong style=\"font-weight:bolder;\"><t t-out=\" &quot;{0:,.4f\"></t>\".format(object.amount_total).replace(\".\",\"%\").replace(\",\",\" \").replace(\"%\",\",\")} <t t-out=\"object.pricelist_id.currency_id.name\"></t></strong><br/>\n"
"         Order date: <t t-out=\"object.date_order\"></t><br/>\n"
"       <t t-if=\"object.client_order_ref\">\n"
"         Your reference: <t t-out=\"object.client_order_ref\"></t><br/>\n"
"       </t>\n"
"       <t t-if=\"object.user_id\">\n"
"         Prepared By: <a t-attf-href=\"mailto:{{object.user_id.email or ''}}?subject=Order%20{{object.name}}\" style=\"background-color:transparent;text-decoration-thickness:auto;color:rgb(124, 123, 173);\"><t t-out=\"object.user_id.name\"></t></a>\n"
"       </t>\n"
"    </p><font color=\"#222222\" face=\"Lucica Grande, Ubuntu, Arial, Verdana, sans-serif\"><span style=\"font-size: 12px;\">\n"
"\n"
" <t t-if=\"object.state in (&#x27;draft&#x27;, &#x27;sent&#x27;)\">\n"
"    </span></font><br/>\n"
"        <a style=\"text-decoration:none;background-color:transparent;color: rgb(124, 123, 173); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; text-decoration-thickness: auto; margin-left: 120px;\" t-attf-href=\"{{object.get_portal_url()}}\">\n"
"            <img src=\"https://www.altinkaya.com.tr/web/content/604751?paynow=1\" style=\"border-style:none;vertical-align:middle;\"/>\n"
"        </a><br/><p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">It is also possible to make your payment by clicking \"Pay Now\" button above. <br/>Our web page will open and you will be able to make your payment securely and easily.</p>\n"
"    <font color=\"#222222\" face=\"Lucica Grande, Ubuntu, Arial, Verdana, sans-serif\"><span style=\"font-size: 12px;\">NEW: If you mention your order number </span></font><span style=\"color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; font-weight: bolder; font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; text-align: inherit;\"><t t-out=\"object.name\"></t></span><span style=\"font-size: 12px; color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\"> in the wire transfer/TT description, our system will automatically confirm the order.</span></div><div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;background-color: rgb(255, 255, 255);\"><font color=\"#222222\" face=\"Lucica Grande, Ubuntu, Arial, Verdana, sans-serif\"><span style=\"font-size: 12px;\">\n"
"    </t>\n"
"    </span></font><br/>\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">If you have any question, do not hesitate to contact us.</p>\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\"><strong style=\"font-weight:bolder;\">You can reply this email to contact us.</strong></p>\n"
"\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px;\">Thank you for choosing Altinkaya!</p>\n"
"    <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; width: 375px; margin: 0px; padding: 0px; background-color: rgb(142, 0, 0); border-top-left-radius: 5px; border-top-right-radius: 5px; background-repeat: repeat-x;\">\n"
"        <h3 style=\"font-size:1.40833rem;color:inherit;line-height:1.2;font-weight:bold;font-family:inherit;margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;\">\n"
"            <strong style=\"font-weight:bolder;text-transform:uppercase;\">ALTINKAYA ENCLOSURES FOR ELECTRONICS</strong></h3>\n"
"    </div>\n"
"    <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; width: 347px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: rgb(242, 242, 242);\">\n"
"        <span style=\"color: #222; margin-bottom: 5px; display: block; \">\n"
"        <t t-if=\"object.company_id.street\">\n"
"            <t t-out=\"object.company_id.street\"></t><br/>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.street2\">\n"
"            <t t-out=\"object.company_id.street2\"></t><br/>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.city or object.company_id.zip\">\n"
"            <t t-out=\"object.company_id.zip\"></t> <t t-out=\"object.company_id.city\"></t><br/>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.country_id\">\n"
"            <t t-out=\"object.company_id.state_id and (&#x27;%s, &#x27; % object.company_id.state_id.name) or &#x27;&#x27;\"></t> Turkey<br/>\n"
"        </t>\n"
"        </span>\n"
"        <t t-if=\"object.company_id.phone\">\n"
"            <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; \">\n"
"                Phone:  <t t-out=\"object.company_id.phone\"></t><br/>Fax  :  <t t-out=\"object.company_id.fax\"></t>\n"
"\n"
"            </div>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.website\">\n"
"            <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                Web : <a href=\"http://www.altinkaya.com\" style=\"background-color:transparent;text-decoration-thickness:auto;color:rgb(124, 123, 173);\">www.altinkaya.com</a>\n"
"            </div>\n"
"        </t>\n"
"        <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"/>\n"
"    </div>\n"
"<p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;color: rgb(34, 34, 34); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; margin-top: 15px;\">You can rate your customer experience at the following link.</p>\n"
"            <a t-attf-href=\"{{object.survey_url}}\" style=\"text-decoration:none;background-color:transparent;color: rgb(255, 255, 255); font-family: &quot;Lucica Grande&quot;, Ubuntu, Arial, Verdana, sans-serif; font-size: 13px; background-color: rgb(135, 90, 123); padding: 8px 16px; border-radius: 5px;\">\n"
"                Rate the Experience\n"
" </a>\n"
"</div>\n"
"            </body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body><div style=\"font-size:13px;font-family: 'Lucica Grande', Ubuntu, Arial, Verdana, sans-serif; font-size: 12px; color: rgb(34, 34, 34); background-color: #FFF; \">\n"
"\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Hello, <t t-out=\"object.partner_id.name\"></t></p>\n"
"    \n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Here is your <t t-out=\"object.state in (&#x27;draft&#x27;, &#x27;sent&#x27;) and &#x27;quotation&#x27; or &#x27;order confirmation&#x27;\"></t> from Altinkaya Enclosures For Electronics: </p>\n"
"\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;border-left: 1px solid #8e0000; margin-left: 30px;\">\n"
"         <strong style=\"font-weight:bolder;\">REFERENCES</strong><br/>\n"
"         Order number: <strong style=\"font-weight:bolder;\"><t t-out=\"object.name\"></t></strong><br/>\n"
"         Order total: <strong style=\"font-weight:bolder;\"><t t-out=\"object.amount_total\"></t> <t t-out=\"object.pricelist_id.currency_id.name\"></t></strong><br/>\n"
"         Order date: <t t-out=\"object.date_order\"></t><br/>\n"
"       <t t-if=\"object.origin\">\n"
"         Order reference: <t t-out=\"object.origin\"></t><br/>\n"
"       </t>\n"
"       <t t-if=\"object.client_order_ref\">\n"
"         Your reference: <t t-out=\"object.client_order_ref\"></t><br/>\n"
"       </t>\n"
"       <t t-if=\"object.user_id\">\n"
"         Prepared By: <a t-attf-href=\"mailto:{{object.user_id.email or ''}}?subject=Order%20{{object.name}}\" style=\"background-color:transparent;text-decoration-thickness:auto;color:rgb(124, 123, 173);\"><t t-out=\"object.user_id.name\"></t></a>\n"
"       </t>\n"
"    </p>\n"
"\n"
" <t t-if=\"object.state in (&#x27;draft&#x27;, &#x27;sent&#x27;)\">\n"
"    <br/>\n"
"        <a style=\"background-color:transparent;text-decoration-thickness:auto;color:rgb(124, 123, 173);margin-left: 120px;\" t-attf-href=\"{{object.get_portal_url()}}\">\n"
"            <img src=\"https://pay.altinkaya.com.tr/pay/images/pay_now.gif\" style=\"border-style:none;vertical-align:middle;\"/>\n"
"        </a><br/><p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">It is also possible to make your payment by clicking \"Pay Now\" button above. <br/>Our web page will open and you will be able to make your payment securely and easily.</p>\n"
"    <br/>\n"
"    </t>\n"
"    <br/>\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">If you have any question, do not hesitate to contact us.</p>\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><strong style=\"font-weight:bolder;\">You can reply this email to contact us.</strong></p>\n"
"\n"
"    <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Thank you for choosing Altinkaya!</p>\n"
"    <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;width: 375px; margin: 0px; padding: 0px; background-color: #8E0000; border-top-left-radius: 5px 5px; border-top-right-radius: 5px 5px; background-repeat: repeat no-repeat;\">\n"
"        <h3 style=\"font-size:1.40833rem;color:inherit;line-height:1.2;font-weight:bold;font-family:inherit;margin: 0px; padding: 2px 14px; font-size: 12px; color: #DDD;\">\n"
"            <strong style=\"font-weight:bolder;text-transform:uppercase;\">ALTINKAYA ENCLOSURES FOR ELECTRONICS</strong></h3>\n"
"    </div>\n"
"    <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;width: 347px; margin: 0px; padding: 5px 14px; line-height: 16px; background-color: #F2F2F2;\">\n"
"        <span style=\"color: #222; margin-bottom: 5px; display: block; \">\n"
"        <t t-if=\"object.company_id.street\">\n"
"            <t t-out=\"object.company_id.street\"></t><br/>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.street2\">\n"
"            <t t-out=\"object.company_id.street2\"></t><br/>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.city or object.company_id.zip\">\n"
"            <t t-out=\"object.company_id.zip\"></t> <t t-out=\"object.company_id.city\"></t><br/>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.country_id\">\n"
"            <t t-out=\"object.company_id.state_id and (&#x27;%s, &#x27; % object.company_id.state_id.name) or &#x27;&#x27;\"></t> Turkey<br/>\n"
"        </t>\n"
"        </span>\n"
"        <t t-if=\"object.company_id.phone\">\n"
"            <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;margin-top: 0px; margin-right: 0px; margin-bottom: 0px; margin-left: 0px; padding-top: 0px; padding-right: 0px; padding-bottom: 0px; padding-left: 0px; \">\n"
"                Phone:  <t t-out=\"object.company_id.phone\"></t><br/>Fax  :  <t t-out=\"object.company_id.fax\"></t>\n"
"\n"
"            </div>\n"
"        </t>\n"
"        <t t-if=\"object.company_id.website\">\n"
"            <div style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"                Web : <a href=\"http://www.altinkaya.eu\" style=\"background-color:transparent;text-decoration-thickness:auto;color:rgb(124, 123, 173);\">www.altinkaya.eu</a>\n"
"            </div>\n"
"        </t>\n"
"        <p style=\"margin:0px 0 1rem 0;font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"/>\n"
"    </div>\n"
"<p style=\"font-size:13px;font-family:&quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;margin-top:15px;\">You can rate your customer experience at the following link.</p>\n"
"            <a t-attf-href=\"{{object.survey_url}}\" style=\"text-decoration:none;color:rgb(77, 119, 143);background-color:#875A7B; padding:8px 16px 8px 16px; color:#fff; border-radius:5px; font-size:13px\">\n"
"                Rate the Experience\n"
" </a>\n"
"</div>\n"
"            </body>\n"
"</html>\n"

