<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="res_partner_email_check_tree_view">
        <field name="name">res.partner.email.check.tree</field>
        <field name="model">res.partner</field>
        <field name="arch" type="xml">
            <tree string="Contacts">
                <field name="display_name" string="Name"/>
                <field name="email_invalid" />
                <field name="email" />
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="res_partner_email_check_act_window">
        <field name="name">Customer Email Check</field>
        <field name="res_model">res.partner</field>
        <field name="view_mode">kanban,tree,form,activity</field>
        <field name="view_id" ref="res_partner_email_check_tree_view"/>
        <field name="search_view_id" ref="base.view_res_partner_filter"/>
        <field name="domain">[('email_invalid', '=', True), "|", ("active", "=", True), ("active", "=", False)]</field>
    </record>

    <record model="ir.ui.menu" id="res_partner_email_check_menu">
        <field name="name">Email Check</field>
        <field name="parent_id" ref="sale.sale_order_menu"/>
        <field name="action" ref="altinkaya_sales.res_partner_email_check_act_window"/>
        <field name="sequence" eval="4"/>
        <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
    </record>

</odoo>
