<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_segment_form_view" model="ir.ui.view">
        <field name="name">res.partner.segment.form</field>
        <field name="model">res.partner.segment</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <h1>
                        <field name="name" />
                    </h1>
                    <group>
                        <field name="code" />
                        <field name="description" />
                    </group>
                    <notebook>
                        <page name="partners" string="Partners">
                            <field
                                name="partner_ids"
                                widget="one2many_list"
                                readonly="1"
                            />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="res_partner_segment_tree_view" model="ir.ui.view">
        <field name="name">res.partner.segment.tree</field>
        <field name="model">res.partner.segment</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="code" />
            </tree>
        </field>
    </record>

    <record id="res_partner_segment_act_window" model="ir.actions.act_window">
        <field name="name">Segments</field>
        <field name="res_model">res.partner.segment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="res_partner_segment_menu" model="ir.ui.menu">
        <field name="name">Segments</field>
        <field name="parent_id" ref="crm.crm_menu_config" />
        <field name="action" ref="res_partner_segment_act_window" />
        <field name="sequence" eval="16" />
    </record>
</odoo>
