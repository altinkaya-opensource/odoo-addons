<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

		<record id="view_partner_form" model="ir.ui.view">
			<field name="name">res.partner.tax.office.inherit</field>
			<field name="model">res.partner</field>
			<field name="inherit_id" ref="base.view_partner_form" />
			<field name="arch" type="xml">
				<field name="vat" position="before">
					<field string="Tax Office Name" name="tax_office_name" />

				</field>
			</field>
		</record>

		<record id="res_partner_view_form_altinkaya" model="ir.ui.view">
			<field name="name">altinkaya_telfax.partner.form</field>
			<field name="model">res.partner</field>
			<field name="inherit_id" ref="base.view_partner_form" />
			<field eval="12445" name="priority" />
			<field name="arch" type="xml">

				<xpath
        expr="//page[@name='sales_purchases']/group[@name='container_row_2']/group[@name='sale']/field[@name='company_registry']"
        position="before"
      >
						<field name="segment_id" />
				</xpath>
				<xpath expr="//group[@name='currency_difference']" position="before">
					<group>
						<group>
							<group string="Credit Insurance" name="credit_insurance" attrs="{'invisible': [('country_id', '=', 224)]}">
								<field name="credit_insurance" />
								<field name="credit_insurance_validity" />
							</group>
						</group>
						<xpath expr="//group[@name='accounting_entries']" position="move"/>
					</group>
				</xpath>

				<xpath expr="/form/sheet/group/group//field[@name='mobile']" position="after">
					<field name="z_contact_name" />
				</xpath>
				<xpath expr="//group[@name='container']" position="inside">
					<group>
						<field name="z_tel_kampanya" />
						<field name="z_kat_postala" />
						<field name="z_kat_postalandi" />
						<field name="z_kat_email" />
					</group>
					<group colspan="4">
						<field name="industry_id"/>
						<field
						name="secondary_industry_ids"
						widget="many2many_tags"
						attrs="{'invisible': [('is_company', '=', False),
						('show_partner_industry_for_person', '=', False)]}"
					/>
						<field name="nace_product_categ_ids" widget="many2many_tags" string="Hedef Ürün Kategorisi"/>
					</group>
				</xpath>
				<xpath expr="/form/sheet/notebook/page[@name='internal_notes']" position="attributes">
					<attribute name="invisible">1</attribute>
				</xpath>
				<xpath expr="/form/sheet/notebook/page[@name='accounting']" position="after">
					<page name="internal_notes" string="Notes" modifiers="{}">
						<group colspan="2" col="2" modifiers="{}">
							<separator string="Warning on the Sales Order" colspan="4" modifiers="{}" />
							<field name="sale_warn" nolabel="1" modifiers="{}" colspan="2" />
							<field
              name="sale_warn_msg"
              colspan="2"
              nolabel="1"
              attrs="{'required':[('sale_warn', '!=', False), ('sale_warn','!=','no-message')],'readonly':[('sale_warn','=','no-message')]}"
              modifiers="{'required':[['sale_warn','!=',false],['sale_warn','!=','no-message']],'readonly':[['sale_warn','=','no-message']]}"
            />
						</group>
						<group colspan="2" col="2" modifiers="{}">
							<separator string="Warning on the Purchase Order" colspan="4" modifiers="{}" />
							<field name="purchase_warn" nolabel="1" modifiers="{}" colspan="2" />
							<field
              name="purchase_warn_msg"
              colspan="2"
              nolabel="1"
              attrs="{'required':[('purchase_warn', '!=', False), ('purchase_warn','!=','no-message')],'readonly':[('purchase_warn','=','no-message')]}"
              modifiers="{'required':[['purchase_warn','!=',false],['purchase_warn','!=','no-message']],'readonly':[['purchase_warn','=','no-message']]}"
            />
						</group>
						<group colspan="2" col="2" modifiers="{}">
							<separator string="Warning on the Invoice" colspan="4" modifiers="{}" />
							<field name="invoice_warn" nolabel="1" modifiers="{}" colspan="2" />
							<field
              name="invoice_warn_msg"
              colspan="2"
              nolabel="1"
              attrs="{'required':[('invoice_warn', '!=', False), ('invoice_warn','!=','no-message')],'readonly':[('invoice_warn','=','no-message')]}"
              modifiers="{'required':[['invoice_warn','!=',false],['invoice_warn','!=','no-message']],'readonly':[['invoice_warn','=','no-message']]}"
            />
						</group>
						<group colspan="2" col="2" modifiers="{}">
							<separator string="Warning on the Picking" colspan="4" modifiers="{}" />
							<field name="picking_warn" nolabel="1" modifiers="{}" colspan="2" />
							<field
              name="picking_warn_msg"
              colspan="2"
              nolabel="1"
              attrs="{'required':[('picking_warn', '!=', False), ('picking_warn','!=','no-message')],'readonly':[('picking_warn','=','no-message')]}"
              modifiers="{'required':[['picking_warn','!=',false],['picking_warn','!=','no-message']],'readonly':[['picking_warn','=','no-message']]}"
            />
						</group>
					</page>
				</xpath>
				<xpath expr="/form/sheet//field[@name='category_id']" position="replace" />
				<xpath expr="/form/sheet//field[@name='name']" position="after">
					<h3>
						<field
            name="category_id"
            widget="many2many_tags"
            options="{'color_field': 'color', 'no_create_edit': True}"
            placeholder="Tags..."
          />
					</h3>
				</xpath>
				<xpath expr="/form/sheet/group/group" position="inside">
					<field name="comment" colspan="3"/>

				</xpath>

			</field>
		</record>



		<record id="res_partner_view_tree_altinkaya" model="ir.ui.view">
			<field name="inherit_id" ref="base.view_partner_tree" />
			<field name="name">res.partner.inherit_altinkaya1</field>
			<field name="model">res.partner</field>
			<field name="type">tree</field>
			<field name="arch" type="xml">
				<xpath expr="///field[@name='display_name']" position="after">
					<field name="state_id" />
					<field name="country_id" />
				</xpath>
				<xpath expr="//field[@name='email']" position="attributes">
					<attribute name="invisible">1</attribute>
				</xpath>
			</field>
		</record>


		<record model="ir.ui.view" id="res_partner_search_view_altinkaya">
			<field name="name">res.partner.search.view</field>
			<field name="model">res.partner</field>
			<field name="inherit_id" ref="base.view_res_partner_filter" />
			<field name="arch" type="xml">
				<field name="parent_id" position="after">
					<field name="vat" filter_domain="[('vat','like',self)]" />
				</field>
			</field>
		</record>



</odoo>
