<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <template
        id="sale_order_portal_content_configurations_inherit"
        name="Sales Order Portal Show Partner"
        inherit_id="sale.sale_order_portal_content"
        priority="100"
    >
        <!-- UOM View Precision -->
        <xpath expr="//span[@t-field='line.product_uom_qty']" position="replace">
            <t t-if="line.product_uom.id == 1">
                <span
                    t-field="line.product_uom_qty"
                    t-options='{"widget": "float", "precision": 0}'
                />
            </t>
            <t t-else="">
                <span
                    t-field="line.product_uom_qty"
                    t-options='{"widget": "float", "precision": 2}'
                />
            </t>
        </xpath>

        <!--        Changes invoice's widget-->
        <xpath
            expr="//address[@t-field='sale_order.partner_invoice_id']"
            position="attributes"
        >
            <attribute name="t-options">{"widget": "contact", "fields": ["address",
                "name"], "no_marker": False}
            </attribute>
        </xpath>

        <!--        Changes shipping's widget-->
        <xpath
            expr="//address[@t-field='sale_order.partner_shipping_id']"
            position="attributes"
        >
            <attribute name="t-options">{"widget": "contact", "fields": ["address",
                "name"], "no_marker": False}
            </attribute>
        </xpath>

        <!--        Adds the partner right next to the addresses in the portal-->
        <xpath
            expr="//div[@id='informations']/div[@class='row']/div[@class='col-lg-6'][1]"
            position="before"
        >
            <div id="partner" class="col-lg-6">
                <strong class="d-block mb-1">Partner</strong>
                <address
                    t-field="sale_order.partner_id"
                    t-options='{"widget": "contact", "fields": ["name", "address", "phone", "mobile", "email"], "no_marker": False}'
                />
                <div style="height:20px" />
            </div>
        </xpath>

        <xpath expr="//div[@id='introduction']" position="inside">
            <!--        Adds sale_order.order_state to sale portal-->
            <div class="my-2  text-info">
                <i class="fa fa-spinner" />
                <strong>Order State:</strong>
                <span t-field="sale_order.order_state" />
            </div>
            <!--        Adds cargo trackings-->
            <div>
                <t
                    t-set="trackable_pickings"
                    t-value="sale_order.picking_ids.filtered(lambda p: p.carrier_tracking_url and p.shipping_number)"
                />
                <ul t-if="trackable_pickings" class="list-unstyled">
                    <li t-foreach="trackable_pickings" t-as="picking">
                        <span t-esc="picking.carrier_id.name" /> (<span
                        t-esc="picking.shipping_number"
                    />)
                        <a
                        class="btn btn-info mx-auto mb-1"
                        title="Cargo Tracking"
                        target="_blank"
                        t-att-href="picking.carrier_tracking_url"
                    >
                            <i class="fa fa-truck" />
                            Where is my cargo?
                        </a>
                    </li>
                </ul>
            </div>
        </xpath>

        <!--        Adds these fields to sale portal: (incoterm, destination_port, fiscal_position_id, warehouse_id, payment_term_id)-->
        <xpath expr="//div[@id='informations']" position="after">
            <div id="other info">
                <hr />
                <t t-if="sale_order.incoterm and sale_order.destination_port">
                    <div class="mb-1 row rounded col-lg-6 col-12">
                        <div class="col-12 g-0 px-0">
                            <t t-if="sale_order.incoterm">
                                <strong>Incoterm:</strong>
                                <span t-field="sale_order.incoterm" />
                            </t>
                        </div>
                        <div class="col-12 g-0 px-0">
                            <t t-if="sale_order.destination_port">
                                <strong>Destination Port:</strong>
                                <span t-field="sale_order.destination_port" />
                            </t>
                        </div>
                    </div>
                </t>
                <t t-else="">
                    <div class="mb-1">
                        <t t-if="sale_order.incoterm">
                            <strong>Incoterm:</strong>
                            <span t-field="sale_order.incoterm" />
                        </t>
                    </div>
                    <div class="mb-1">
                        <t t-if="sale_order.destination_port">
                            <strong>Destination Port:</strong>
                            <span t-field="sale_order.destination_port" />
                        </t>
                    </div>
                </t>

                <div class="mb-1">
                    <t t-if="sale_order.fiscal_position_id">
                        <strong>Fiscal Position:</strong>
                        <span t-field="sale_order.fiscal_position_id" />
                    </t>
                </div>
                <div class="mb-1">
                    <t t-if="sale_order.warehouse_id">
                        <strong>Warehouse:</strong>
                        <span t-field="sale_order.warehouse_id" />
                    </t>
                </div>
                <div class="mb-1">
                    <t t-if="sale_order.payment_term_id">
                        <strong>Payment Term:</strong>
                        <span t-field="sale_order.payment_term_id" />
                    </t>
                </div>

                <div style="height: 10px;" />
            </div>
        </xpath>

        <!--        Makes the invoice visible only if there is an einvoice-->
        <xpath expr="//t[@t-set='invoices']" position="attributes">
            <attribute name="t-value">[i for i in sale_order.invoice_ids if i.state not
                in ['draft', 'cancel'] and i.einvoice_pdf_id]
            </attribute>
        </xpath>
    </template>

    <template
        id="sale_order_sale_order_portal_content_inherit_precision"
        name="Sales Order Portal Inherit Content Precision"
        inherit_id="sale.sale_order_portal_content"
        priority="100"
    >

        <xpath expr="//t[@t-set='display_discount']" position="after">
            <t t-set="has_stock_available" t-value="False"/>
            <t t-foreach="sale_order.order_line" t-as="check_line">
                <t t-if="check_line.product_id and check_line.product_id.type == 'product' and not check_line.display_type">
                    <t t-set="check_qty_data" t-value="check_line.product_id.get_quantity_website()" />
                    <t t-set="check_total_available" t-value="check_qty_data.get('qty_unreserved_sincan', 0) + check_qty_data.get('qty_unreserved_merkez', 0)" />
                    <t t-if="check_line.product_uom_qty &lt;= check_total_available">
                        <t t-set="has_stock_available" t-value="True"/>
                    </t>
                </t>
            </t>
        </xpath>

        <xpath expr="//table[@id='sales_order_table']/thead/tr/th[@id='product_name_header']" position="after">
            <th t-if="has_stock_available" class="text-center">Stock Available</th>
        </xpath>

        <xpath expr="//td[@id='product_name']" position="after">
            <td t-if="has_stock_available" class="text-center">
                <t t-if="line.product_id and line.product_id.type == 'product'">
                    <t t-set="qty_data" t-value="line.product_id.get_quantity_website()" />
                    <t t-set="total_available" t-value="qty_data.get('qty_unreserved_sincan', 0) + qty_data.get('qty_unreserved_merkez', 0)" />
                    <t t-if="line.product_uom_qty &lt;= total_available">
                        <span class="text-success">
                            <i class="fa fa-check-circle" />
                        </span>
                    </t>
                </t>
            </td>
        </xpath>

        <xpath expr="//span[@t-field='line.price_subtotal']" position="attributes">
            <attribute name="t-options">{"widget": "float", "precision": 2}</attribute>
        </xpath>

        <xpath expr="//span[@t-field='line.price_total']" position="attributes">
            <attribute name="t-options">{"widget": "float", "precision": 2}</attribute>
        </xpath>
        <xpath expr="//td[@t-if='not line.is_downpayment']" position="inside">
            <t t-out="line.currency_id.symbol" />
        </xpath>

        <xpath expr="//span[@t-out='current_subtotal']" position="attributes">
            <attribute name="t-options">{"widget": "float", "precision": 2}</attribute>
        </xpath>

        <xpath expr="//span[@t-out='current_subtotal']" position="after">
            <t t-out="line.currency_id.symbol" />
        </xpath>
    </template>

    <template
        id="sale_order_sale_order_portal_template_inherit_precision"
        name="Sales Order Portal Inherit Precision"
        inherit_id="sale.sale_order_portal_template"
    >
        <xpath expr="//b[@t-field='sale_order.amount_total']" position="attributes">
            <attribute name="t-options">{"widget": "float", "precision": 2}</attribute>
        </xpath>
        <xpath expr="//b[@t-field='sale_order.amount_total']" position="after">
            <t t-out="sale_order.currency_id.symbol" />
        </xpath>
    </template>

    <template
        id="sale_portal_hide_production_orders"
        name="Sale Portal Hide Production Orders"
        inherit_id="sale_mrp.sale_order_portal_content_inherit_sale_mrp"
    >
        <xpath expr="//t[@t-set='mrp_productions']" position="after">
            <t t-set="mrp_productions" t-value="False" />
        </xpath>
    </template>
</odoo>
