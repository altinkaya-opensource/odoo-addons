<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="view_product_product_copy_wizard_form" model="ir.ui.view">
        <field name="name">product.product.copy.wizard.form</field>
        <field name="model">wizard.product.product.copy</field>
        <field name="arch" type="xml">
            <form string="Copy Product Variant">

                <group>
                    <field
            name="source_product_id"
            readonly="1"
            string="Product to Copy"
          />

                    <field name="domain_attribute_value_ids" invisible="1" />
                    <field
            name="variant_value_ids"
            widget="many2many_tags"
            options="{'no_create': True}"
            domain="[('id', 'in', domain_attribute_value_ids)]"
            string="Variant Values"
          />
                </group>

                <footer>
                    <button
            string="Copy Product"
            name="action_copy"
            type="object"
            default_focus="1"
            class="btn-primary"
          />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_product_copy_variant" model="ir.actions.act_window">
        <field name="name">Copy Product Variant</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.product.product.copy</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_source_product_id': active_id}</field>
        <field name="binding_model_id" ref="product.model_product_product" />
    </record>


</odoo>
