<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_production_form_inherit_print_product_label" model="ir.ui.view">
    <field name="inherit_id" ref="mrp.mrp_production_form_view" />
    <field name="name">mrp.production.form.inherit.label</field>
    <field name="model">mrp.production</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <field name="production_location_id" position="after">
        <div colspan="2">
          <span class="text-muted">Mevcut / Uygun / Tahmini:</span>
          <group col="2">
            <group class="oe_form">
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Sincan:</strong>
                <field
                  name="qty_available_sincan"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_sincan"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_sincan"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
              </div>
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">CNC:</strong>
                <field
                  name="qty_available_cnc"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_cnc"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_cnc"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
              </div>
            </group>
          </group>
          <group col="2">
            <group class="oe_form">
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Merkez:</strong>
                <field
                  name="qty_available_merkez"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_merkez"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_merkez"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />

              </div>
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Metal:</strong>
                <field
                  name="qty_available_metal"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_metal"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_metal"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
              </div>
            </group>
          </group>
          <group col="2">
            <group class="oe_form">
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Enjeksiyon:</strong>
                <field
                  name="qty_available_enjeksiyon"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_enjeksiyon"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_enjeksiyon"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />

              </div>
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Boya:</strong>
                <field
                  name="qty_available_boya"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_boya"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_boya"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
              </div>
            </group>
          </group>
          <group col="2">
            <group class="oe_form">
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Montaj:</strong>
                <field
                  name="qty_available_montaj"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_montaj"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_montaj"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
              </div>
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Baskı:</strong>
                <field
                  name="qty_available_baski"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_baski"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_baski"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
              </div>
            </group>
          </group>
          <group col="2">
            <group class="oe_form">
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Torna:</strong>
                <field
                  name="qty_available_torna"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_torna"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_torna"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />

              </div>
              <div class="d-flex flex-row align-items-start" style="width:200px;">
                <strong class="me-2">Kaplama:</strong>
                <field
                  name="qty_available_kaplama"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_unreserved_kaplama"
                  class="w-auto"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
                <span class="mx-2">/</span>
                <field
                  name="qty_virtual_kaplama"
                  widget="uom"
                  options="{'uom_field': 'product_uom_id'}"
                />
              </div>
            </group>
          </group>
        </div>
      </field>
      <xpath expr="//field[@name='qty_producing']" position="attributes">
        <attribute name="widget">uom</attribute>
        <attribute name="options">{'uom_field': 'product_uom_id'}</attribute>
      </xpath>
      <xpath expr="//field[@name='product_qty']" position="attributes">
        <attribute name="widget">uom</attribute>
        <attribute name="options">{'uom_field': 'product_uom_id'}</attribute>
      </xpath>
      <xpath expr="//field[@name='product_uom_qty']" position="attributes">
        <attribute name="widget">uom</attribute>
        <attribute name="options">{'uom_field': 'product_uom'}</attribute>
      </xpath>
      <!-- <xpath expr="//field[@name='forecast_availability']" position="attributes">
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom_id'}</attribute>
            </xpath> -->
      <xpath expr="//field[@name='quantity_done']" position="attributes">
        <attribute name="widget">uom</attribute>
        <attribute name="options">{'uom_field': 'product_uom'}</attribute>
      </xpath>
      <xpath expr="//field[@name='reserved_availability']" position="attributes">
        <attribute name="widget">uom</attribute>
        <attribute name="options">{'uom_field': 'product_uom'}</attribute>
      </xpath>

      <xpath
        expr="//field[@name='move_raw_ids']/tree/field[@name='quantity_done']"
        position="after"
      >
        <button
          name="action_open_detailed_form"
          type="object"
          icon="fa-eye"
          title="Move Details"
        />
        <button
          name="action_create_procurement"
          type="object"
          string="Tedarik"
          attrs="{'invisible':[('state','in',['waiting','done'])]}"
        />
        <button
          name="action_make_mts"
          type="object"
          string="Stoktan Al"
          attrs="{'invisible':[('state', 'not in', ['waiting','cancel'])]}"
        />
      </xpath>

    </field>
  </record>


  <record id="view_form_scrap_move_line" model="ir.ui.view">
    <field name="inherit_id" ref="stock.view_stock_move_line_operation_tree" />
    <field name="name">mrp.stock.move.scrap.button</field>
    <field name="model">stock.move.line</field>
    <field name="type">form</field>
    <field name="arch" type="xml">
      <xpath expr="//field[@name='lot_id']" position="after">
        <field name="state" invisible="1" />
        <field name="product_type" invisible="1" />
        <button
          name="action_scrap_button"
          type="object"
          string="Scrap"
          class="oe_highlight"
          attrs="{'invisible':['|', ('state', 'in', ['draft', 'cancel', 'done']), ('product_type', '!=', 'product')]}"
        />
      </xpath>
    </field>
  </record>

</odoo>
