<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_production_form_inherit_print_product_label" model="ir.ui.view">
        <field name="inherit_id" ref="mrp.mrp_production_form_view" />
        <field name="name">mrp.production.form.inherit.label</field>
        <field name="model">mrp.production</field>
        <field name="type">form</field>
        <field name="arch" type="xml">
            <field name="production_location_id" position="after">
                <div colspan="2">
                    <group col="2">
                        <group class="oe_form">
                          <div class="d-flex flex-row align-items-start">
                            <strong class="me-2">Sincan:</strong>
                            <field name="qty_available_sincan" class="ms-4" />/<field
                  name="qty_virtual_sincan"
                />

                          </div>
                          <div class="d-flex flex-row align-items-start">
                            <strong class="me-2">CNC:</strong>
                            <field name="qty_available_cnc" />/<field
                  name="qty_virtual_cnc"
                />
                          </div>
                        </group>
                    </group>
                    <group col="2">
                      <group class="oe_form">
                        <div class="d-flex flex-row align-items-start">
                          <strong class="me-2">Merkez:</strong>
                          <field name="qty_available_merkez" class="ms-4" />/<field
                  name="qty_virtual_merkez"
                />

                        </div>
                        <div class="d-flex flex-row align-items-start">
                          <strong class="me-2">Metal:</strong>
                          <field name="qty_available_metal" />/<field
                  name="qty_virtual_metal"
                />
                        </div>
                      </group>
                  </group>
                  <group col="2">
                    <group class="oe_form">
                      <div class="d-flex flex-row align-items-start">
                        <strong class="me-2">Enjeksiyon:</strong>
                        <field name="qty_available_enjek" />/<field
                  name="qty_virtual_enjek"
                />

                      </div>
                      <div class="d-flex flex-row align-items-start">
                        <strong class="me-2">Boya:</strong>
                        <field name="qty_available_boya" />/<field
                  name="qty_virtual_boya"
                />
                      </div>
                    </group>
                </group>
                <group col="2">
                  <group class="oe_form">
                    <div class="d-flex flex-row align-items-start">
                      <strong class="me-2">Montaj:</strong>
                      <field name="qty_available_montaj" class="ms-4" />/<field
                  name="qty_virtual_montaj"
                />
                    </div>
                    <div class="d-flex flex-row align-items-start">
                      <strong class="me-2">Baskı:</strong>
                      <field name="qty_available_baski" />/<field
                  name="qty_virtual_baski"
                />
                    </div>
                  </group>
              </group>
              <group col="2">
                <group class="oe_form">
                  <div class="d-flex flex-row align-items-start">
                    <strong class="me-2">Torna:</strong>
                    <field name="qty_available_torna" class="ms-4" />/<field
                  name="qty_virtual_torna"
                />

                  </div>
                  <div class="d-flex flex-row align-items-start">
                    <strong class="me-2">Kaplama:</strong>
                    <field name="qty_available_kaplama" />/<field
                  name="qty_virtual_kaplama"
                />
                  </div>
                </group>
            </group>
                </div>
            </field>

            <xpath
        expr="//field[@name='move_raw_ids']/tree/field[@name='quantity_done']"
        position="after"
      >
                <button
          name="action_create_procurement"
          type="object"
          string="Tedarik"
          attrs="{'invisible':[('state','in',['waiting','done'])]}"
        />
                <button
          name="action_make_mts"
          type="object"
          string="Stoktan Al"
          attrs="{'invisible':[('state', 'not in', ['waiting','cancel'])]}"
        />
            </xpath>

        </field>
    </record>


