<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_partner_view_form_picking_responsible" model="ir.ui.view">
        <field name="name">res.partner.form.picking.responsible</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']/field[@name='user_id']" position="after">
                <field
                    name="default_picking_responsible_id"
                    attrs="{'invisible': [('is_company', '=', False), ('parent_id', '!=', False)]}"
                    options="{'no_create': True}"
                />
            </xpath>
        </field>
    </record>
</odoo>
