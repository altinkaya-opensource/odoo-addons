<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="view_quant_inherit_altinkaya" model="ir.ui.view">
            <field name="name">Altinkaya Quant Customization</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_form_editable" />
            <field name="priority" eval="40" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <button
          type="object"
          name="action_show_reserved_moves"
          class="oe_stat_button"
          icon="fa-code-fork"
          string="Reservation Moves"
          attrs="{'invisible': [('reserved_quantity', '=', 0)]}"
        >
                    </button>
                </xpath>
            </field>
        </record>
        <record id="view_quant_inherit_tree_altinkaya" model="ir.ui.view">
            <field name="name">Altinkaya Quant Tree Customization</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree" />
            <field name="priority" eval="40" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_uom_id']" position="after">
                    <field name="reserved_quantity" invisible="1" />
                    <button
          type="object"
          name="action_show_reserved_moves"
          class="oe_stat_button"
          string="Reservation Moves"
          attrs="{'invisible': [('reserved_quantity', '=', 0)]}"
        >
                    </button>
                </xpath>
            </field>
        </record>
        <record id="view_quant_inherit_tree_editable_inherit" model="ir.ui.view">
            <field name="name">stock_quant_tree_editable_inherit</field>
            <field name="model">stock.quant</field>
            <field name="inherit_id" ref="stock.view_stock_quant_tree_editable" />
            <field name="priority" eval="40" />
            <field name="arch" type="xml">
                <xpath expr="//tree/field[@name='inventory_quantity_auto_apply']" position="attributes">
                    <attribute name="widget">uom</attribute>
                    <attribute name="options">{'uom_field': 'product_uom_id'}</attribute>
                </xpath>
                <xpath expr="//tree/field[@name='reserved_quantity']" position="attributes">
                    <attribute name="widget">uom</attribute>
                    <attribute name="options">{'uom_field': 'product_uom_id'}</attribute>
                </xpath>
            </field>
        </record>
</odoo>
