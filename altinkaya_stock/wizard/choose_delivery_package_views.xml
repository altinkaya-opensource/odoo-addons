<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="inherit_choose_delivery_package_view_form" model="ir.ui.view">
        <field name="name">choose.delivery.package.form.inherit</field>
        <field name="model">choose.delivery.package</field>
        <field name="inherit_id" ref="delivery.choose_delivery_package_view_form" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='picking_id']" position="after">
                <div id="package_dimensions" class="d-flex mb-3">
                    <span class="oe_inline o_form_label me-3">Package Dimensions</span>

                    <field name="package_length" nolabel="1" />
                    <span class="oe_inline o_form_label mx-3 text-muted">x</span>
                    <field name="package_width" nolabel="1" />
                    <span class="oe_inline o_form_label mx-3 text-muted">x</span>
                    <field name="package_height" nolabel="1" />
                    <field
            name="package_dimensions_uom_id"
            class="ms-3"
            style="pointer-events:none;"
          />

                </div>

            </xpath>

            <xpath expr="//group" position="replace">
                <group>
                    <label for="package_weight" />
                    <div name="weight_div" class="d-flex">
                        <field name="package_weight" class="me-3 w-25" />
                        <field
              name="package_weight_uom_id"
              style="pointer-events:none;"
            />
                    </div>

                    <label for="calculated_weight" />
                    <div name="calculated_weight_div" class="d-flex">
                        <field name="calculated_weight" class="me-3 w-25" />
                        <field
              name="package_weight_uom_id"
              style="pointer-events:none;"
            />
                    </div>
                    <field name="company_id" invisible="1" />
                    <field
            name="delivery_package_type_id"
            options="{'no_create_edit': True, 'no_create': True}"
            attrs="{'required': [('package_id_to_bind', '=', False)]}"
          />
                    <field name="available_package_ids" invisible="1" />
                    <field
            name="package_id_to_bind"
            attrs="{'invisible': [('available_package_ids', '=', False)]}"
            domain="[('id', 'in', available_package_ids)]"
          />
                </group>

            </xpath>


            <xpath expr="//footer" position="before">
                <field
          name="selected_move_line_ids"
          context="{'default_wizard_id': id}"
          required="1"
        >

                    <tree
            editable="bottom"
            decoration-success="product_uom_qty==qty_to_pack"
            decoration-danger="qty_to_pack &gt; product_uom_qty or product_uom_qty &gt; qty_to_pack or qty_to_pack == 0"
          >
                        <field name="move_line_id" readonly="1" />
                        <field name="lot_id" readonly="1" />
                        <field
              name="qty_to_pack"
              widget="uom"
              options="{'uom_field': 'product_uom_id'}"
              readonly="1"
            />
                        <field
              name="product_uom_qty"
              widget="uom"
              options="{'uom_field': 'product_uom_id'}"
            />
                        <field name="product_uom_id" />
                    </tree>
                </field>


            </xpath>
        </field>
    </record>
</odoo>
