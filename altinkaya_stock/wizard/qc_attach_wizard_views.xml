<odoo>
  <record id="view_qc_attach_wizard_form" model="ir.ui.view">
    <field name="name">qc.attach.wizard.form</field>
    <field name="model">qc.attach.wizard</field>
    <field name="arch" type="xml">
      <form string="Add Product Picture" create="0" edit="1">
        <sheet>
          <group>
            <field name="picking_id" readonly="1" />
            <field name="product_id" readonly="1" />
            <field name="lot_id" readonly="1" />
          </group>
          <group>
            <field
              name="image_ids"
              widget="many2many_binary"
              string="Upload/Take Photo"
              options="{'accept': 'image/*', 'capture': 'environment'}"
            />
          </group>
        </sheet>
        <footer>
          <button
            name="action_confirm"
            type="object"
            string="Apply"
            class="btn-primary"
          />
          <button string="Cancel" special="cancel" class="btn-secondary" />
        </footer>
      </form>
    </field>
  </record>
</odoo>
