<?xml version="1.0" encoding="UTF-8" ?>
<odoo>


    <record id="view_create_packaging_pallet_form" model="ir.ui.view">
        <field name="name">create.packaging.pallet.form</field>
        <field name="model">wizard.create.packaging.pallet</field>
        <field name="arch" type="xml">
            <form string="Create Pallet">
                <field name="picking_id" invisible="1" />
                <div id="package_dimensions" class="d-flex mb-3">
                    <span class="oe_inline o_form_label me-3">Package Dimensions</span>

                    <field name="package_length" nolabel="1" />
                    <span class="oe_inline o_form_label mx-3 text-muted">x</span>
                    <field name="package_width" nolabel="1" />
                    <span class="oe_inline o_form_label mx-3 text-muted">x</span>
                    <field name="package_height" nolabel="1" />
                    <field name="package_dimensions_uom_id" class="ms-3" style="pointer-events:none;" />

                </div>

                <group>
                    <label for="package_weight" />
                    <div name="weight_div" class="d-flex">
                        <field name="package_weight" class="me-3 w-25" />
                        <field name="package_weight_uom_id" style="pointer-events:none;" />
                    </div>

                    <label for="calculated_weight" />
                    <div name="calculated_weight_div" class="d-flex">
                        <field name="calculated_weight" class="me-3 w-25" />
                        <field name="package_weight_uom_id" style="pointer-events:none;" />
                    </div>
                </group>
                <field name="packaging_line_ids" context="{'default_wizard_id': id}" required="1">

                    <tree editable="bottom">
                        <field name="package_id" options="{'no_create': True, 'no_create_edit': True}" />
                        <field name="pack_length" />
                        <field name="width" />
                        <field name="height" />
                        <field name="length_uom_id" nolabel="1" />
                        <field name="shipping_weight" />
                    </tree>
                </field>


                <footer>
                    <button string="Create Pallet" name="action_create_pallet" type="object" default_focus="1" class="btn-primary" />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_create_packaging_pallet" model="ir.actions.act_window">
        <field name="name">Create Pallet</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.create.packaging.pallet</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_picking_id': active_id}</field>
    </record>


</odoo>
