<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form_simple_modif" model="ir.ui.view">
        <field name="name">res.users.preferences.altinkaya.theme</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <group name="preferences" position="inside">
                <group name="altinkaya_theme_preferences" string="Appearance">
                    <field name="dark_mode_device_dependent" />
                    <field
                        name="dark_mode"
                        attrs="{'invisible': [('dark_mode_device_dependent', '=', True)]}"
                    />
                </group>
            </group>
        </field>
    </record>
</odoo>
