        >product.template.uom.precision.product_template_tree_view_uom</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='qty_available']" position="attributes">
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'uom_id'}</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='virtual_available']" position="attributes">
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'uom_id'}</attribute>
            </xpath>
        </field>
    </record>
</odoo>
