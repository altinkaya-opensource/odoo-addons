<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_order_form_uom" model="ir.ui.view">
        <field name="name">sale.order.uom.precision.view_order_form_uom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='qty_unreserved_merkez']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='qty_unreserved_sincan']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='producible_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='qty_delivered']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='customer_lead']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='qty_unreserved_sincan']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='qty_unreserved_merkez']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/form//field[@name='producible_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='sale_line_history']/tree/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='stock_move_ids']/tree/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='stock_move_ids']/tree/field[@name='quantity_done']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='production_ids']/tree/field[@name='product_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom_id'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_order_line_tree_uom" model="ir.ui.view">
        <field
            name="name"
        >sale.order.line.uom.precision.view_order_line_tree_uom</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.view_order_line_tree" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath expr="//tree/field[@name='product_uom_qty']" position="attributes">
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath expr="//tree/field[@name='qty_delivered']" position="attributes">
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="sale_order_line_view_form_readonly_uom" model="ir.ui.view">
        <field
            name="name"
        >sale.order.line.uom.precision.sale_order_line_view_form_readonly_uom</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='product_uom_qty'][not(ancestor::field)]"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='qty_delivered'][not(ancestor::field)]"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='qty_invoiced'][not(ancestor::field)]"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_trendyol_order_form_uom" model="ir.ui.view">
        <field
            name="name"
        >trendyol.order.uom.precision.view_trendyol_order_form_uom</field>
        <field name="model">trendyol.order</field>
        <field name="inherit_id" ref="trendyol_integration.view_trendyol_order_form" />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']"
                position="after"
            >
                <field name="product_uom" invisible="1" />
            </xpath>
        </field>
    </record>

    <record id="view_hepsiburada_order_form_uom" model="ir.ui.view">
        <field
            name="name"
        >hepsiburada.order.uom.precision.view_hepsiburada_order_form_uom</field>
        <field name="model">hepsiburada.order</field>
        <field
            name="inherit_id"
            ref="hepsiburada_integration.view_hepsiburada_order_form"
        />
        <field name="priority" eval="1000" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']"
                position="attributes"
            >
                <attribute name="widget">uom</attribute>
                <attribute name="options">{'uom_field': 'product_uom'}</attribute>
            </xpath>
            <xpath
                expr="//field[@name='order_line']/tree/field[@name='product_uom_qty']"
                position="after"
            >
                <field name="product_uom" invisible="1" />
            </xpath>
        </field>
    </record>
</odoo>
