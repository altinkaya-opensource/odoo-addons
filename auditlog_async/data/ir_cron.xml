<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="ir_cron_process_pending_auditlog" model="ir.cron">
        <field name="name">Auditlog: Process Pending Entries</field>
        <field name="model_id" ref="model_auditlog_pending" />
        <field name="state">code</field>
        <field name="code">model.trigger_processing()</field>
        <field name="interval_number" eval="5" />
        <field name="interval_type">minutes</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
    </record>

    <record id="ir_cron_cleanup_pending_auditlog" model="ir.cron">
        <field name="name">Auditlog: Cleanup Done Pending Entries</field>
        <field name="model_id" ref="model_auditlog_pending" />
        <field name="state">code</field>
        <field name="code">model.cleanup_done(days=7)</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
    </record>
</odoo>
