<?xml version="1.0" encoding="UTF-8" ?>
<odoo>

        <record id="res_partner_change_accounts_eur_view" model="ir.ui.view">
            <field name="name">change.partner.accounts.eur.popup</field>
            <field name="model">change.partner.accounts.eur</field>
            <field name="arch" type="xml">
                <form string="Change Partner Accounts to EUR">
                    <p
        >This action will change every accounting records of partner. Ask your administrator before use it.</p>
                    <footer>
                        <button
            string="Change Accounts"
            name="change_partners_account_to_eur"
            type="object"
            default_focus="1"
            class="btn-primary"
          />
                        <button
            string="Cancel"
            class="btn-secondary"
            special="cancel"
          />
                    </footer>
                </form>
            </field>
        </record>

        <!-- <act_window id="action_res_partner_change_accounts_eur"
                    multi="True"
                    key2="client_action_multi" name="Change Accounts to EUR"
                    res_model="change.partner.accounts.eur" src_model="res.partner"
                    view_mode="form" target="new" view_type="form"/> -->

            <record id="action_res_partner_change_accounts_eur" model="ir.actions.act_window">
        <field name="name">Change Accounts to EUR</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">change.partner.accounts.eur</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_source_product_id': active_id}</field>
        <field name="binding_model_id" ref="base.model_res_partner" />
    </record>
</odoo>
