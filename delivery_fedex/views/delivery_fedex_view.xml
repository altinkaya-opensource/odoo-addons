<?xml version="1.0" encoding="utf-8" ?>
<odoo>
  <record id="view_delivery_carrier_form" model="ir.ui.view">
    <field name="model">delivery.carrier</field>
    <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
    <field name="arch" type="xml">
      <xpath expr="//notebook" position='inside'>
        <page
          string="FedEx Configuration"
          attrs="{'invisible': [('delivery_type', '!=', 'fedex')]}"
        >
          <group>
            <group string="Connection">
              <field
                name="fedex_client_id"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_client_secret"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
                password="True"
              />
              <field
                name="fedex_tracking_client_id"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_tracking_client_secret"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
                password="True"
              />
              <field
                name="fedex_account_number"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
            </group>
            <group string="Delivery Information">
              <field
                name="fedex_service_type"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_customs_payment_type"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />

              <field
                name="fedex_pickup_type"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_carrier_code"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_stock_height"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_commercial_invoice"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_label_paper_type"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
              <field
                name="fedex_label_resolution"
                attrs="{'required': [('delivery_type', '=', 'fedex')]}"
              />
            </group>
          </group>
        </page>
      </xpath>
    </field>
  </record>
</odoo>
