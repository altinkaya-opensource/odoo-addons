#. module: delivery_integration_base
#: model:mail.template,body_html:delivery_integration_base.delivery_mail_template
msgid ""
"<html>\n"
"  <body><p/><p>Hello,</p><p><br/><span style=\"font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\">Your order with reference number </span><t t-out=\"object.sale_id.client_order_ref or &#x27;&#x27;\"></t> <t t-out=\"object.sale_id.name or &#x27;&#x27;\"></t> has been shipped.</p><p>Shipping Method: <t t-out=\"object.carrier_id.display_name or &#x27;&#x27;\"></t></p><p>Tracking Number: <span style=\"font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\"><t t-out=\"object.shipping_number or &#x27;&#x27;\"></t></span><br/></p><p>Tracking Link: <a t-attf-href=\"{{object.carrier_tracking_url or ''}}\" style=\"color:rgb(77, 119, 143);\"><t t-out=\"object.carrier_tracking_url or &#x27;&#x27;\"></t></a></p><p><br/></p><p>ALTINKAYA Enclosure for Electronics</p>\n"
"<t t-if=\"object.sale_id \">\n"
"<p>You can rate your customer experience via following link.</p><a t-attf-href=\"{{object.sale_id.survey_url}}\" style=\"color:rgb(77, 119, 143);background-color:#875A7B; padding:8px 16px 8px 16px; color:#fff; border-radius:5px; font-size:13px\">Rate Your Experience</a>\n"
"</t>\n"
"<br/>\n"
"<br/></body>\n"
"</html>\n"
msgstr ""
"<html>\n"
"  <body>\n"
"    <p style=\"margin-right: 0px; margin-left: 0px; font-family: &quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Merhaba,</p>\n"
"    <p style=\"margin-right: 0px; margin-left: 0px; font-family: &quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><br/><span style=\"font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\"><t t-out=\"object.sale_id.client_order_ref or &#x27;&#x27;\"></t> </span><t t-out=\"object.sale_id.name or &#x27;&#x27;\"></t> referans numaralı siparişiniz kargoya verilmiştir.</p>\n"
"    <p style=\"margin-right: 0px; margin-left: 0px; font-family: &quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Teslimat Yöntemi: <t t-out=\"object.carrier_id.display_name or &#x27;&#x27;\"></t></p>\n"
"    <p style=\"margin-right: 0px; margin-left: 0px; font-family: &quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Takip No: <span style=\"font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\"><t t-out=\"object.shipping_number or &#x27;&#x27;\"></t></span><br/></p>\n"
"    <p style=\"margin-right: 0px; margin-left: 0px; font-family: &quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\"><t t-out=\"&#x27;Takip için: %s&#x27; % object.carrier_tracking_url if object.carrier_tracking_url else &#x27;&#x27;\"></t><br/></p>\n"
"    <p style=\"margin-right: 0px; margin-left: 0px; font-family: &quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">\n"
"      <br/>\n"
"    </p>\n"
"    <p style=\"margin-right: 0px; margin-left: 0px; font-family: &quot;Lucida Grande&quot;, Helvetica, Verdana, Arial, sans-serif;\">Altınkaya Elektronik Cihaz Kutuları</p>\n"
"  </body>\n"
"</html>\n"

