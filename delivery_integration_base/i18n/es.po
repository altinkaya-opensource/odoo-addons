#. module: delivery_integration_base
#: model:mail.template,body_html:delivery_integration_base.delivery_mail_template
msgid ""
"<p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\"></p><p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">Hello,</p><p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">\n"
"<t t-out=\"object.sale_id.name or ''\"></t><t t-if=\"object.sale_id.client_order_ref\"><t t-esc=\"' (%s) ' % object.sale_id.client_order_ref\"></t></t> Your order with reference number has been transmitted.\n"
"</p><p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">Delivery Method: <t t-out=\"object.carrier_id.display_name or ''\"></t>\n"
"</p><p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">Tracking No: <span style=\"font-style: initial; font-variant-ligatures: initial; font-variant-caps: initial; font-weight: initial; text-align: inherit;\">\n"
"    <t t-out=\"object.shipping_number or ''\"></t>\n"
"  </span>\n"
" <br>\n"
"</p><p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">For tracking <a t-attf-href=\"#{object.carrier_id.get_tracking_link(object)}\" t-esc=\"object.carrier_id.get_tracking_link(object)\" style=\"text-decoration: none; box-sizing: border-box; color: #495057;\">TrackingLink</a></p><p style=\"margin:0px 0 12px 0;box-sizing:border-box;\"></p><p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">Altinkaya Electronic Enclosures &amp; Components</p><t t-if=\"object.sale_id \">\n"
"  <p style=\"box-sizing:border-box;margin:0px 0 12px 0;font-size:13px;font-family:'Lucida Grande', Helvetica, Verdana, Arial, sans-serif;\">You can rate your customer experience at the link below.</p>\n"
"  <a t-attf-href=\"#{object.sale_id.survey_url}\" style=\"box-sizing:border-box;text-decoration:none;color:#4d778f;background-color:#875A7B; padding:8px 16px 8px 16px; color:#fff; border-radius:5px; font-size:13px\">Rate Experience</a>\n"
"</t>"
