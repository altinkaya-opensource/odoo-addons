<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_move_form_delivery_integration" model="ir.ui.view">
        <field name="name">account.move.form.delivery.integration</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="action_send_to_shipper"
                        type="object"
                        string="Send to Shipper"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'posted')]}"/>
            </header>
        </field>
    </record>
</odoo>