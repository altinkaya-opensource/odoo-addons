<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record model="ir.ui.view" id="account_move_delivery">
        <field name="name">account.move.delivery.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form" />
        <field name="type">form</field>
        <field name="arch" type="xml">
            <xpath
                expr="//group[@name='sale_info_group']/field[@name='ref']"
                position="after"
            >
                <field name="delivery_ref_no" />
                <field
                    name="multiple_delivery_ref_no"
                    attrs="{'invisible': [('multiple_delivery_ref_no', '=', False)]}"
                />
            </xpath>
        </field>
    </record>
</odoo>
