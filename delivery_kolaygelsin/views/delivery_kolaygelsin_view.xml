<odoo>
    <record id="view_kolaygelsin_delivery_carrier_form" model="ir.ui.view">
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position='before'>
                <page
                    string="Kolay Gelsin Configuration"
                    attrs="{'invisible': [('delivery_type', '!=', 'kolaygelsin')]}"
                >
                    <group>
                        <group string="Connection">
                            <field
                                name="kolaygelsin_username"
                                attrs="{'required': [('delivery_type', '=', 'kolaygelsin')]}"
                            />
                            <field name="kolaygelsin_password" />
                            <field name="kolaygelsin_cc_code" />
                        </group>
                        <group string="Logistics">
                            <field name="price_rule_ids" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
