<odoo>
    <record id="view_yurtici_delivery_carrier_form" model="ir.ui.view">
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook/page[1]" position='before'>
                <page
          string="Yurtiçi Configuration"
          attrs="{'invisible': [('delivery_type', '!=', 'yurtici')]}"
        >
                    <group>
                        <group string="Connection">
                            <field
                name="yurtici_username"
                attrs="{'required': [('delivery_type', '=', 'yurtici'), ('shipment_level', '=', 'send_shipment')]}"
              />
                            <field name="yurtici_password" />
                            <field name="yurtici_user_lang" />
                            <field
                name="yurtici_barcodeservice_username"
                attrs="{'required': [('delivery_type', '=', 'yurtici'), ('shipment_level', '=', 'send_shipment_and_barcode')]}"
              />
                            <field name="yurtici_barcodeservice_password" />
                            <field name="yurtici_barcodeservice_customer_code" />
                            <field name="yurtici_barcodeservice_address_code" />
                        </group>


                        <group string="Logistics">
                            <field name="price_rule_ids" />
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
