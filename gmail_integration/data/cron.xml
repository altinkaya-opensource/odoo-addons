<odoo>
    <record id="ir_cron_gmail_fetch_queued" model="ir.cron">
        <field name="name">Gmail Fetch via Queue</field>
        <field name="model_id" ref="model_gmail_integration" />
        <field name="state">code</field>
        <field name="code">model.cron_queue_gmail_fetch()</field>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="numbercall">-1</field>
        <field name="active">True</field>
    </record>
</odoo>
