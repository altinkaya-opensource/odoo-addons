<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Import Orders Cron - Every 15 minutes -->
    <record id="cron_import_orders" model="ir.cron">
        <field name="name">Hepsiburada: Import Orders</field>
        <field name="model_id" ref="model_hepsiburada_backend" />
        <field name="state">code</field>
        <field name="code">model._cron_import_orders()</field>
        <field name="interval_number" eval="15" />
        <field name="interval_type">minutes</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
        <field name="doall" eval="False" />
    </record>

    <!-- Send Invoice Links Cron - Nightly -->
    <record id="cron_send_invoices" model="ir.cron">
        <field name="name">Hepsiburada: Send Invoice Links</field>
        <field name="model_id" ref="model_hepsiburada_backend" />
        <field name="state">code</field>
        <field name="code">model._cron_send_invoices()</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
        <field name="doall" eval="False" />
    </record>

    <!-- Import Questions Cron - Every 30 minutes -->
    <record id="cron_import_questions" model="ir.cron">
        <field name="name">Hepsiburada: Import Questions</field>
        <field name="model_id" ref="model_hepsiburada_backend" />
        <field name="state">code</field>
        <field name="code">model._cron_import_questions()</field>
        <field name="interval_number" eval="30" />
        <field name="interval_type">minutes</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
        <field name="doall" eval="False" />
    </record>

    <!-- Import Claims Cron - Every 30 minutes -->
    <record id="cron_import_claims" model="ir.cron">
        <field name="name">Hepsiburada: Import Claims</field>
        <field name="model_id" ref="model_hepsiburada_backend" />
        <field name="state">code</field>
        <field name="code">model._cron_import_claims()</field>
        <field name="interval_number" eval="30" />
        <field name="interval_type">minutes</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
        <field name="doall" eval="False" />
    </record>

    <!-- Import Settlements Cron - Daily -->
    <record id="cron_import_settlements" model="ir.cron">
        <field name="name">Hepsiburada: Import Settlements</field>
        <field name="model_id" ref="model_hepsiburada_backend" />
        <field name="state">code</field>
        <field name="code">model._cron_import_settlements()</field>
        <field name="interval_number" eval="1" />
        <field name="interval_type">days</field>
        <field name="numbercall" eval="-1" />
        <field name="active" eval="True" />
        <field name="doall" eval="False" />
    </record>
</odoo>
