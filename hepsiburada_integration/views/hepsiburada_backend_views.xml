<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form View -->
    <record id="view_hepsiburada_backend_form" model="ir.ui.view">
        <field name="name">hepsiburada.backend.form</field>
        <field name="model">hepsiburada.backend</field>
        <field name="arch" type="xml">
            <form string="Hepsiburada Backend">
                <header>
                    <button
                        name="action_test_connection"
                        string="Test Connection"
                        type="object"
                        class="btn-primary"
                    />
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button
                            name="action_view_products"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-cube"
                        >
                            <field
                                name="product_count"
                                widget="statinfo"
                                string="Products"
                            />
                        </button>
                        <button
                            name="action_view_orders"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-shopping-cart"
                        >
                            <field
                                name="order_count"
                                widget="statinfo"
                                string="Orders"
                            />
                        </button>
                        <button
                            name="action_view_claims"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-undo"
                        >
                            <field
                                name="claim_count"
                                widget="statinfo"
                                string="Claims"
                            />
                        </button>
                        <button
                            name="action_view_questions"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-question-circle"
                        >
                            <field
                                name="question_count"
                                widget="statinfo"
                                string="Questions"
                            />
                        </button>
                        <button
                            name="action_view_settlements"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-money"
                        >
                            <field
                                name="settlement_count"
                                widget="statinfo"
                                string="Settlements"
                            />
                        </button>
                    </div>
                    <widget
                        name="web_ribbon"
                        title="Archived"
                        bg_color="bg-danger"
                        attrs="{'invisible': [('active', '=', True)]}"
                    />
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Backend Name" />
                        </h1>
                    </div>
                    <group>
                        <group string="API Configuration">
                            <field name="merchant_id" />
                            <field name="hb_username" password="True" />
                            <field name="hb_password" password="True" />
                            <field name="hb_user_agent" />
                            <field name="environment" widget="radio" />
                        </group>
                        <group string="Odoo Configuration">
                            <field
                                name="company_id"
                                groups="base.group_multi_company"
                            />
                            <field name="default_product_id" />
                            <field name="warehouse_ids" widget="many2many_tags" />
                            <field name="pricelist_id" />
                            <field name="sales_team_id" />
                            <field name="fiscal_position_id" />
                            <field name="source_id" />
                            <field name="default_cargo_company_id" />
                            <field name="dispatch_days" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Sync Settings" name="sync_settings">
                            <group>
                                <group string="Auto Sync">
                                    <field name="auto_import_orders" />
                                    <field name="auto_import_claims" />
                                    <field name="auto_import_questions" />
                                    <field name="auto_sync_stock" />
                                    <field name="auto_sync_tracking" />
                                    <field name="auto_send_invoice" />
                                </group>
                                <group string="Order Settings">
                                    <field name="auto_confirm_orders" />
                                    <field name="default_vat_rate" />
                                </group>
                                <group string="Q&amp;A Settings">
                                    <field
                                        name="question_user_ids"
                                        widget="many2many_tags"
                                    />
                                </group>
                                <group string="Accounting">
                                    <field name="marketplace_partner_id" />
                                    <field name="settlement_journal_id" />
                                    <field name="auto_import_settlements" />
                                    <field name="auto_reconcile_settlements" />
                                </group>
                                <group string="Printing">
                                    <field name="label_printer_id" />
                                </group>
                            </group>
                        </page>
                        <page string="Cargo Mapping" name="cargo_mapping">
                            <field name="cargo_mapping_ids">
                                <tree editable="bottom">
                                    <field name="provider_name" />
                                    <field name="carrier_id" />
                                </tree>
                            </field>
                        </page>
                        <page string="Manual Actions" name="manual_actions">
                            <div class="row mt-3">
                                <div class="col-6">
                                    <h3>Import</h3>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <button
                                            name="action_import_orders"
                                            string="Import Orders"
                                            type="object"
                                            class="btn-secondary"
                                            icon="fa-download"
                                        />
                                        <span class="text-muted small">Offset</span>
                                        <field
                                            name="import_orders_offset"
                                            nolabel="1"
                                            class="w-auto"
                                        />
                                        <span class="text-muted small">Limit</span>
                                        <field
                                            name="import_orders_limit"
                                            nolabel="1"
                                            class="w-auto"
                                        />
                                    </div>
                                    <button
                                        name="action_import_claims"
                                        string="Import Claims"
                                        type="object"
                                        class="btn-secondary d-block mb-2"
                                        icon="fa-download"
                                    />
                                    <button
                                        name="action_import_questions"
                                        string="Import Questions"
                                        type="object"
                                        class="btn-secondary d-block mb-2"
                                        icon="fa-download"
                                    />
                                    <button
                                        name="action_import_settlements"
                                        string="Import Settlements"
                                        type="object"
                                        class="btn-secondary d-block mb-2"
                                        icon="fa-download"
                                    />
                                    <button
                                        name="action_import_products"
                                        string="Import Products"
                                        type="object"
                                        class="btn-secondary d-block mb-2"
                                        icon="fa-download"
                                    />
                                </div>
                                <div class="col-6">
                                    <h3>Sync</h3>
                                    <button
                                        name="action_sync_categories"
                                        string="Sync Categories"
                                        type="object"
                                        class="btn-secondary d-block mb-2"
                                        icon="fa-refresh"
                                    />
                                    <button
                                        name="action_sync_brands"
                                        string="Sync Brands"
                                        type="object"
                                        class="btn-secondary d-block mb-2"
                                        icon="fa-refresh"
                                    />
                                    <button
                                        name="action_sync_stock_prices"
                                        string="Sync Stock/Prices"
                                        type="object"
                                        class="btn-secondary d-block mb-2"
                                        icon="fa-refresh"
                                    />
                                </div>
                            </div>
                        </page>
                        <page string="Sync Status" name="sync_status">
                            <group>
                                <group string="Last Sync Times">
                                    <field name="last_order_sync" readonly="0" />
                                    <field name="last_claim_sync" />
                                    <field name="last_question_sync" />
                                    <field name="last_settlement_sync" readonly="0" />
                                    <field name="last_stock_sync" />
                                    <field name="last_category_sync" />
                                    <field name="last_brand_sync" />
                                    <field name="last_product_import_sync" />
                                </group>
                            </group>
                        </page>
                        <page string="Batch Actions" name="batch_actions">
                            <button
                                name="%(action_hepsiburada_product_export_wizard_template)d"
                                string="Batch Product Export"
                                type="action"
                                class="btn-secondary mb-2"
                                icon="fa-upload"
                            />
                            <button
                                name="action_check_batch_requests"
                                string="Check Batch Request Status"
                                type="object"
                                class="btn-secondary mb-2"
                                icon="fa-refresh"
                            />
                        </page>
                    </notebook>
                    <field name="active" invisible="1" />
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hepsiburada_backend_tree" model="ir.ui.view">
        <field name="name">hepsiburada.backend.tree</field>
        <field name="model">hepsiburada.backend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="merchant_id" />
                <field name="environment" />
                <field name="company_id" groups="base.group_multi_company" />
                <field name="product_count" />
                <field name="order_count" />
                <field name="last_order_sync" />
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hepsiburada_backend_search" model="ir.ui.view">
        <field name="name">hepsiburada.backend.search</field>
        <field name="model">hepsiburada.backend</field>
        <field name="arch" type="xml">
            <search string="Search Backends">
                <field name="name" />
                <field name="merchant_id" />
                <filter
                    name="active"
                    string="Active"
                    domain="[('active', '=', True)]"
                />
                <filter
                    name="archived"
                    string="Archived"
                    domain="[('active', '=', False)]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_environment"
                        string="Environment"
                        context="{'group_by': 'environment'}"
                    />
                    <filter
                        name="group_company"
                        string="Company"
                        context="{'group_by': 'company_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hepsiburada_backend" model="ir.actions.act_window">
        <field name="name">Hepsiburada Backends</field>
        <field name="res_model">hepsiburada.backend</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hepsiburada_backend_search" />
        <field name="context">{'search_default_active': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Hepsiburada backend
            </p>
            <p>
                Configure API credentials and sync settings to connect your Odoo
                instance with Hepsiburada marketplace.
            </p>
        </field>
    </record>
</odoo>
