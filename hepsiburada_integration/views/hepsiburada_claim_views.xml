<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Claim Form View -->
    <record id="view_hepsiburada_claim_form" model="ir.ui.view">
        <field name="name">hepsiburada.claim.form</field>
        <field name="model">hepsiburada.claim</field>
        <field name="arch" type="xml">
            <form string="Hepsiburada Claim">
                <header>
                    <button
                        name="action_approve_claim"
                        string="Approve Claim"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('claim_status', 'not in', ['created', 'waiting_in_action'])]}"
                        confirm="Are you sure you want to approve this return claim?"
                        groups="hepsiburada_integration.group_hepsiburada_manager"
                    />
                    <button
                        name="action_create_return_picking"
                        string="Create Return Picking"
                        type="object"
                        attrs="{'invisible': ['|', ('odoo_return_picking_id', '!=', False), ('claim_status', 'not in', ['waiting_in_action', 'accepted'])]}"
                    />
                    <field
                        name="claim_status"
                        widget="statusbar"
                        statusbar_visible="created,waiting_in_action,accepted"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span>Claim </span>
                            <field name="hb_claim_id" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Claim Info">
                            <field name="backend_id" />
                            <field name="hb_order_id" />
                            <field name="odoo_order_id" />
                            <field name="claim_date" />
                            <field name="last_modified_date" />
                        </group>
                        <group string="Return Shipping">
                            <field name="cargo_provider_name" />
                            <field name="cargo_tracking_number" />
                            <field name="cargo_tracking_link" widget="url" />
                            <field name="odoo_return_picking_id" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Claim Lines" name="lines">
                            <field name="line_ids">
                                <tree>
                                    <field name="barcode" />
                                    <field name="product_name" />
                                    <field name="quantity" />
                                    <field name="customer_reason" />
                                    <field name="status" />
                                </tree>
                            </field>
                        </page>
                        <page string="Raw Data" name="raw_data">
                            <field
                                name="raw_data"
                                widget="ace"
                                options="{'mode': 'json'}"
                                readonly="1"
                            />
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <!-- Claim Tree View -->
    <record id="view_hepsiburada_claim_tree" model="ir.ui.view">
        <field name="name">hepsiburada.claim.tree</field>
        <field name="model">hepsiburada.claim</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="claim_status == 'rejected'"
                decoration-success="claim_status == 'accepted'"
                decoration-warning="claim_status == 'waiting_in_action'"
                decoration-muted="claim_status == 'cancelled'"
            >
                <field name="hb_claim_id" />
                <field name="hb_order_id" />
                <field name="claim_date" />
                <field name="claim_status" />
                <field name="total_quantity" />
                <field name="line_count" />
                <field name="cargo_tracking_number" />
                <field name="odoo_return_picking_id" />
                <field name="backend_id" />
            </tree>
        </field>
    </record>

    <!-- Claim Search View -->
    <record id="view_hepsiburada_claim_search" model="ir.ui.view">
        <field name="name">hepsiburada.claim.search</field>
        <field name="model">hepsiburada.claim</field>
        <field name="arch" type="xml">
            <search string="Search Claims">
                <field name="hb_claim_id" />
                <field name="hb_order_id" />
                <field name="cargo_tracking_number" />
                <separator />
                <filter
                    name="created"
                    string="Created"
                    domain="[('claim_status', '=', 'created')]"
                />
                <filter
                    name="waiting"
                    string="Waiting in Action"
                    domain="[('claim_status', '=', 'waiting_in_action')]"
                />
                <filter
                    name="accepted"
                    string="Accepted"
                    domain="[('claim_status', '=', 'accepted')]"
                />
                <filter
                    name="rejected"
                    string="Rejected"
                    domain="[('claim_status', '=', 'rejected')]"
                />
                <separator />
                <filter
                    name="no_return_picking"
                    string="No Return Picking"
                    domain="[('odoo_return_picking_id', '=', False), ('claim_status', 'in', ['waiting_in_action', 'accepted'])]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_status"
                        string="Status"
                        context="{'group_by': 'claim_status'}"
                    />
                    <filter
                        name="group_date"
                        string="Claim Date"
                        context="{'group_by': 'claim_date:day'}"
                    />
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Claim Action -->
    <record id="action_hepsiburada_claim" model="ir.actions.act_window">
        <field name="name">Hepsiburada Claims</field>
        <field name="res_model">hepsiburada.claim</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hepsiburada_claim_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Hepsiburada claims yet
            </p>
            <p>
                Return claims will appear here when imported from Hepsiburada.
                Configure auto-import in backend settings or click "Import Claims" manually.
            </p>
        </field>
    </record>
</odoo>
