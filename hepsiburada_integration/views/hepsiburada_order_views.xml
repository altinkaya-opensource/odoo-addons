<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form View -->
    <record id="view_hepsiburada_order_form" model="ir.ui.view">
        <field name="name">hepsiburada.order.form</field>
        <field name="model">hepsiburada.order</field>
        <field name="arch" type="xml">
            <form string="Hepsiburada Order" create="false">
                <header>
                    <field name="hb_status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="hb_order_number" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Hepsiburada Info">
                            <field name="hb_order_id" />
                            <field name="hb_customer_id" />
                            <field name="backend_id" />
                            <field name="delivery_type" />
                            <field name="due_date" />
                        </group>
                        <group string="Shipping">
                            <field name="cargo_provider_name" />
                            <field name="hb_package_number" />
                            <field name="cargo_tracking_number" />
                            <field name="cargo_tracking_link" widget="url" />
                        </group>
                    </group>
                    <group string="Odoo Order">
                        <field name="odoo_id" />
                    </group>
                    <notebook>
                        <page string="Line Items" name="line_items">
                            <field name="hb_line_item_ids">
                                <tree>
                                    <field name="hb_line_item_id" />
                                    <field name="hb_sku" />
                                    <field name="merchant_sku" />
                                    <field name="quantity" />
                                    <field name="unit_price" />
                                    <field name="total_price" />
                                    <field name="vat_rate" />
                                    <field name="vat_amount" />
                                    <field name="commission_amount" />
                                    <field name="status" />
                                    <field name="sale_line_id" />
                                </tree>
                            </field>
                        </page>
                        <page string="Raw Data" name="raw_data">
                            <field name="raw_data" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tree View -->
    <record id="view_hepsiburada_order_tree" model="ir.ui.view">
        <field name="name">hepsiburada.order.tree</field>
        <field name="model">hepsiburada.order</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-danger="hb_status == 'cancelled'">
                <field name="hb_order_number" />
                <field name="hb_status" />
                <field name="odoo_id" />
                <field name="hb_customer_name" />
                <field name="cargo_provider_name" />
                <field name="cargo_tracking_number" />
                <field name="hb_package_number" />
                <field name="backend_id" />
                <field name="create_date" />
            </tree>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_hepsiburada_order_search" model="ir.ui.view">
        <field name="name">hepsiburada.order.search</field>
        <field name="model">hepsiburada.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="hb_order_number" />
                <field name="cargo_tracking_number" />
                <field name="hb_package_number" />
                <filter
                    name="open"
                    string="Open"
                    domain="[('hb_status', '=', 'open')]"
                />
                <filter
                    name="in_transit"
                    string="In Transit"
                    domain="[('hb_status', '=', 'in_transit')]"
                />
                <filter
                    name="delivered"
                    string="Delivered"
                    domain="[('hb_status', '=', 'delivered')]"
                />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('hb_status', '=', 'cancelled')]"
                />
                <group expand="0" string="Group By">
                    <filter
                        name="group_status"
                        string="Status"
                        context="{'group_by': 'hb_status'}"
                    />
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_hepsiburada_order" model="ir.actions.act_window">
        <field name="name">Hepsiburada Orders</field>
        <field name="res_model">hepsiburada.order</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
