<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Form View -->
    <record id="view_hepsiburada_order_form" model="ir.ui.view">
        <field name="name">hepsiburada.order.form</field>
        <field name="model">hepsiburada.order</field>
        <field name="arch" type="xml">
            <form string="Hepsiburada Order" create="false">
                <header>
                    <button
                        name="action_send_invoice"
                        string="Send Invoice"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': ['|', ('invoice_link_sent', '=', True), ('hb_status', '=', 'cancelled')]}"
                    />
                    <button
                        name="action_cancel_in_hepsiburada"
                        string="Cancel in HB"
                        type="object"
                        class="btn-danger"
                        attrs="{'invisible': [('hb_status', '!=', 'open')]}"
                    />
                    <field name="hb_status" widget="statusbar" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <span
                                class="oe_edit_only"
                                style="font-weight: bold; color: #A9A9A9;"
                            >
                                Sipariş No:
                            </span>
                            <field
                                name="hb_order_number"
                                readonly="1"
                                class="oe_inline"
                            />
                        </h1>
                    </div>
                    <group>
                        <group string="Hepsiburada Info">
                            <field name="hb_order_id" readonly="1" />
                            <field name="hb_customer_id" readonly="1" />
                            <field name="hb_customer_name" readonly="1" />
                            <field name="backend_id" readonly="1" />
                            <field name="delivery_type" readonly="1" />
                            <field name="due_date" readonly="1" />
                            <field name="invoice_link_sent" readonly="1" />
                            <field name="invoice_sent_date" readonly="1" />
                        </group>
                        <group string="Shipping">
                            <field name="hb_full_address" readonly="1" />
                            <field name="cargo_provider_name" readonly="1" />
                            <field name="hb_package_number" readonly="1" />
                            <field name="cargo_tracking_number" readonly="1" />
                            <field
                                name="cargo_tracking_link"
                                widget="url"
                                readonly="1"
                            />
                        </group>
                    </group>
                    <group string="Odoo Order">
                        <field name="partner_id" readonly="1" />
                        <field name="odoo_id" />
                    </group>
                    <notebook>
                        <page name="line_items" string="Line Items">
                            <field name="hb_line_item_ids">
                                <tree>
                                    <field name="hb_line_item_id" />
                                    <field name="hb_sku" />
                                    <field name="merchant_sku" />
                                    <field name="quantity" />
                                    <field name="unit_price" />
                                    <field name="total_price" />
                                    <field name="vat_rate" />
                                    <field name="vat_amount" />
                                    <field name="commission_amount" />
                                    <field name="status" />
                                    <field name="sale_line_id" />
                                </tree>
                            </field>
                        </page>
                        <page name="raw_data" string="Raw Data">
                            <field name="raw_data" readonly="1" />
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Tree View -->
    <record id="view_hepsiburada_order_tree" model="ir.ui.view">
        <field name="name">hepsiburada.order.tree</field>
        <field name="model">hepsiburada.order</field>
        <field name="arch" type="xml">
            <tree create="false" decoration-danger="hb_status == 'cancelled'">
                <field name="hb_order_number" />
                <field name="hb_status" />
                <field name="odoo_id" />
                <field name="partner_id" />
                <field name="hb_full_address" />
                <field name="cargo_provider_name" />
                <!-- <field name="cargo_tracking_number" /> -->
                <field name="hb_package_number" />
                <field name="backend_id" />
                <field name="create_date" />
            </tree>
        </field>
    </record>
    <!-- Search View -->
    <record id="view_hepsiburada_order_search" model="ir.ui.view">
        <field name="name">hepsiburada.order.search</field>
        <field name="model">hepsiburada.order</field>
        <field name="arch" type="xml">
            <search>
                <field name="hb_order_number" />
                <field name="cargo_tracking_number" />
                <field name="hb_package_number" />
                <filter
                    name="open"
                    string="Open"
                    domain="[('hb_status', '=', 'open')]"
                />
                <filter
                    name="in_transit"
                    string="In Transit"
                    domain="[('hb_status', '=', 'in_transit')]"
                />
                <filter
                    name="delivered"
                    string="Delivered"
                    domain="[('hb_status', '=', 'delivered')]"
                />
                <filter
                    name="cancelled"
                    string="Cancelled"
                    domain="[('hb_status', '=', 'cancelled')]"
                />
                <group string="Group By" expand="0">
                    <filter
                        name="group_status"
                        string="Status"
                        context="{'group_by': 'hb_status'}"
                    />
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>
    <!-- Action -->
    <record id="action_hepsiburada_order" model="ir.actions.act_window">
        <field name="name">Hepsiburada Orders</field>
        <field name="res_model">hepsiburada.order</field>
        <field name="view_mode">tree,form</field>
    </record>
</odoo>
