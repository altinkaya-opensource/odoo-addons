<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hepsiburada_product_binding_form" model="ir.ui.view">
        <field name="name">hepsiburada.product.binding.form</field>
        <field name="model">hepsiburada.product.binding</field>
        <field name="arch" type="xml">
            <form string="Hepsiburada Product Binding">
                <header>
                    <button
                        name="action_export"
                        string="Submit to HB Catalog"
                        type="object"
                        class="btn-primary"
                        attrs="{'invisible': [('sync_state', 'not in', ['draft', 'error'])]}"
                    />
                    <button
                        name="action_update"
                        string="Update Listing"
                        type="object"
                        attrs="{'invisible': [('sync_state', '!=', 'approved')]}"
                    />
                    <button
                        name="action_sync_stock_price"
                        string="Sync Stock/Price"
                        type="object"
                        attrs="{'invisible': [('sync_state', '!=', 'approved')]}"
                    />
                    <button
                        name="action_activate_listing"
                        string="Activate Listing"
                        type="object"
                        attrs="{'invisible': ['|', ('sync_state', '!=', 'approved'), ('is_listing_active', '=', True)]}"
                    />
                    <button
                        name="action_deactivate_listing"
                        string="Deactivate Listing"
                        type="object"
                        attrs="{'invisible': ['|', ('sync_state', '!=', 'approved'), ('is_listing_active', '=', False)]}"
                    />
                    <button
                        name="action_set_draft"
                        string="Set to Draft"
                        type="object"
                        attrs="{'invisible': [('sync_state', '=', 'draft')]}"
                    />
                    <field
                        name="sync_state"
                        widget="statusbar"
                        statusbar_visible="draft,pending,approved"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group string="Product">
                            <field name="odoo_id" />
                            <field name="backend_id" />
                            <field name="merchant_sku" />
                            <field name="hepsiburada_sku" readonly="1" />
                            <field name="variant_group_id" />
                            <field name="tracking_id" readonly="1" />
                        </group>
                        <group string="Mapping">
                            <field name="hepsiburada_category_id" />
                            <field name="hepsiburada_brand_id" />
                            <field name="vat_rate" />
                            <field name="warranty_months" />
                        </group>
                    </group>
                    <group>
                        <group string="Prices">
                            <field name="marketplace_list_price" />
                            <field name="marketplace_sale_price" />
                            <field name="last_sent_price" readonly="1" />
                        </group>
                        <group string="Stock">
                            <field name="marketplace_quantity" />
                            <field name="last_sent_quantity" readonly="1" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Listing" name="listing">
                            <group>
                                <group>
                                    <field name="dispatch_time" />
                                    <field name="cargo_company_1" />
                                    <field name="cargo_company_2" />
                                    <field name="cargo_company_3" />
                                </group>
                                <group>
                                    <field name="shipping_address_label" />
                                    <field name="claim_address_label" />
                                    <field name="shipping_profile_name" />
                                    <field name="is_listing_active" />
                                </group>
                                <group>
                                    <field name="maximum_purchasable_quantity" />
                                    <field name="minimum_purchasable_quantity" />
                                </group>
                                <group>
                                    <field name="customization_text_type" />
                                    <field name="customization_text_length" />
                                    <field name="has_installation" />
                                </group>
                            </group>
                        </page>
                        <page string="Attributes" name="attributes">
                            <field
                                name="attributes"
                                widget="ace"
                                options="{'mode': 'json'}"
                            />
                        </page>
                        <page string="Sync Info" name="sync_info">
                            <group>
                                <field name="last_sync_date" />
                                <field name="sync_error" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_hepsiburada_product_binding_tree" model="ir.ui.view">
        <field name="name">hepsiburada.product.binding.tree</field>
        <field name="model">hepsiburada.product.binding</field>
        <field name="arch" type="xml">
            <tree
                decoration-danger="sync_state == 'error'"
                decoration-warning="sync_state == 'rejected'"
                decoration-success="sync_state == 'approved'"
                decoration-info="sync_state == 'pending'"
            >
                <field name="name" />
                <field name="merchant_sku" />
                <field name="hepsiburada_sku" />
                <field name="hepsiburada_category_id" />
                <field name="hepsiburada_brand_id" />
                <field name="marketplace_quantity" />
                <field name="marketplace_sale_price" widget="monetary" />
                <field name="sync_state" />
                <field name="is_listing_active" />
                <field name="backend_id" />
                <field name="last_sync_date" />
            </tree>
        </field>
    </record>

    <record id="view_hepsiburada_product_binding_search" model="ir.ui.view">
        <field name="name">hepsiburada.product.binding.search</field>
        <field name="model">hepsiburada.product.binding</field>
        <field name="arch" type="xml">
            <search string="Search Hepsiburada Bindings">
                <field name="name" />
                <field name="merchant_sku" />
                <field name="hepsiburada_sku" />
                <field name="odoo_id" />
                <field name="hepsiburada_category_id" />
                <field name="hepsiburada_brand_id" />
                <separator />
                <filter
                    name="draft"
                    string="Draft"
                    domain="[('sync_state', '=', 'draft')]"
                />
                <filter
                    name="pending"
                    string="Pending"
                    domain="[('sync_state', '=', 'pending')]"
                />
                <filter
                    name="approved"
                    string="Approved"
                    domain="[('sync_state', '=', 'approved')]"
                />
                <filter
                    name="error"
                    string="Error"
                    domain="[('sync_state', '=', 'error')]"
                />
                <separator />
                <group expand="0" string="Group By">
                    <filter
                        name="group_state"
                        string="Sync State"
                        context="{'group_by': 'sync_state'}"
                    />
                    <filter
                        name="group_category"
                        string="Category"
                        context="{'group_by': 'hepsiburada_category_id'}"
                    />
                    <filter
                        name="group_backend"
                        string="Backend"
                        context="{'group_by': 'backend_id'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="action_hepsiburada_product_binding" model="ir.actions.act_window">
        <field name="name">Hepsiburada Products</field>
        <field name="res_model">hepsiburada.product.binding</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_hepsiburada_product_binding_search" />
    </record>
</odoo>
