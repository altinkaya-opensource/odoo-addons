<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_hepsiburada_category_sync_wizard" model="ir.ui.view">
        <field name="name">hepsiburada.category.sync.wizard.form</field>
        <field name="model">hepsiburada.category.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Sync Hepsiburada Categories">
                <group>
                    <field name="backend_id" />
                    <field name="sync_attributes_for_leaves" />
                </group>
                <footer>
                    <button
                        name="action_sync"
                        type="object"
                        string="Start Sync"
                        class="btn-primary"
                    />
                    <button special="cancel" string="Cancel" />
                </footer>
            </form>
        </field>
    </record>

    <record id="action_hepsiburada_category_sync_wizard" model="ir.actions.act_window">
        <field name="name">Sync Hepsiburada Categories</field>
        <field name="res_model">hepsiburada.category.sync.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
