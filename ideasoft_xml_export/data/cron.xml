<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record
        id="ir_cron_generate_ideasoft_xml_export"
        forcecreate="True"
        model="ir.cron"
    >
        <field name="name">Generate Ideasoft XML Files</field>
        <field name="user_id" ref="base.user_root" />
        <field name="interval_number" eval="2" />
        <field name="model_id" ref="ideasoft_xml_export.model_ideasoft_backend" />
        <field name="interval_type">hours</field>
        <field name="numbercall" eval="-1" />
        <field eval="False" name="doall" />
        <field name="code">model.regenerate_all_records()</field>
        <field eval="True" name="active" />
        <field name="state">code</field>
    </record>
</odoo>
