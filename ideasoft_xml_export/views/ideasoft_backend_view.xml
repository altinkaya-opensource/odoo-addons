<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="view_ideasoft_backend_form" model="ir.ui.view">
        <field name="name">ideasoft.backend.form</field>
        <field name="model">ideasoft.backend</field>
        <field name="arch" type="xml">
            <form string="Ideasoft Backend">

                <header>
                    <button
            name="generate_export_xml"
            type="object"
            string="Regenerate XML"
            class="oe_highlight"
          />
                </header>

                <sheet>
                    <group>
                        <field name="name" />
                        <field name="access_token" />
                        <field name="xml_url" widget="url" />
                        <field name="tax_id" />
                        <field name="brand_name" />
                        <field name="currency_id" />
                        <field name="lang_id" />
                        <field
              name="location_ids"
              widget="many2many_tags"
              options="{'no_create': True}"
            />
                        <field name="product_domain" />
                        <field name="attachment_id" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ideasoft_backend_tree" model="ir.ui.view">
        <field name="name">ideasoft.backend.tree</field>
        <field name="model">ideasoft.backend</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="access_token" />
            </tree>
        </field>
    </record>


    <record id="action_ideasoft_backend" model="ir.actions.act_window">
        <field name="name">Ideasoft Backend</field>
        <field name="res_model">ideasoft.backend</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
    id="menu_ideasoft_backend"
    name="Ideasoft Backend"
    parent="sale.menu_sale_config"
    action="action_ideasoft_backend"
    sequence="10"
  />

</odoo>
