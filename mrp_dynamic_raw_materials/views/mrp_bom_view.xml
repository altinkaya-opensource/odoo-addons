<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_mrp_bom_form_inherit_dynamic_materials" model="ir.ui.view">
        <field name="name">mrp.bom.form.inherit.dynamic_materials</field>
        <field name="model">mrp.bom</field>
        <field name='inherit_id' ref="mrp.mrp_bom_form_view" />
        <field name="arch" type="xml">
            <xpath
                expr="//field[@name='bom_line_ids']/tree//field[@name='product_uom_id']"
                position="after"
            >
                <field name="factor_attribute_id" />
                <field name="attribute_factor" />
            </xpath>
        </field>
    </record>
    <record id="view_mrp_bom_line_tree_inherit_dynamic_materials" model="ir.ui.view">
        <field name="name">mrp.bom.line.tree.inherit.dynamic.materials</field>
        <field name="model">mrp.bom.line</field>
        <field name="inherit_id" ref="altinkaya_mrp.mrp_bom_line_view_tree" />
        <field name="arch" type="xml">
            <field name="product_uom_id" position="after">
                <field name="factor_attribute_id" optional="show" />
                <field name="attribute_factor" optional="show" />
            </field>
        </field>
    </record>
</odoo>
