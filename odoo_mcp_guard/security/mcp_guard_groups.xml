<?xml version="1.0" encoding="UTF-8" ?>
<odoo noupdate="1">
    <record id="module_category_mcp_guard" model="ir.module.category">
        <field name="name">MCP Guard</field>
        <field name="sequence" eval="90" />
    </record>

    <record id="group_mcp_guard_reviewer" model="res.groups">
        <field name="name">MCP Guard Reviewer</field>
        <field name="category_id" ref="module_category_mcp_guard" />
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]" />
        <field name="comment">May approve or reject pending MCP guard requests.</field>
    </record>

    <record id="rule_mcp_guard_request_own" model="ir.rule">
        <field name="name">MCP guard request: own only</field>
        <field name="model_id" ref="model_mcp_guard_request" />
        <field name="domain_force">[('agent_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_mcp_guard_request_reviewer" model="ir.rule">
        <field name="name">MCP guard request: reviewer all</field>
        <field name="model_id" ref="model_mcp_guard_request" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_guard_reviewer'))]" />
    </record>
    <record id="rule_mcp_guard_change_own" model="ir.rule">
        <field name="name">MCP guard change: own only</field>
        <field name="model_id" ref="model_mcp_guard_change" />
        <field name="domain_force">[('request_id.agent_user_id', '=', user.id)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]" />
        <field name="perm_read" eval="True" />
        <field name="perm_write" eval="False" />
        <field name="perm_create" eval="False" />
        <field name="perm_unlink" eval="False" />
    </record>
    <record id="rule_mcp_guard_change_reviewer" model="ir.rule">
        <field name="name">MCP guard change: reviewer all</field>
        <field name="model_id" ref="model_mcp_guard_change" />
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_mcp_guard_reviewer'))]" />
    </record>
</odoo>
