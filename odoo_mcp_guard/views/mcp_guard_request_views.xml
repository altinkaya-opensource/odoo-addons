<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="mcp_guard_request_view_tree" model="ir.ui.view">
        <field name="name">mcp.guard.request.tree</field>
        <field name="model">mcp.guard.request</field>
        <field name="arch" type="xml">
            <tree
                decoration-warning="state == 'pending'"
                decoration-success="state in ('applied','auto_applied')"
                decoration-danger="state in ('denied','rejected','failed')"
            >
                <field name="name" />
                <field name="create_date" />
                <field name="agent_user_id" />
                <field name="model" />
                <field name="method" />
                <field name="mode_at_call" />
                <field name="state" />
                <field name="approver_id" />
            </tree>
        </field>
    </record>

    <record id="mcp_guard_request_view_search" model="ir.ui.view">
        <field name="name">mcp.guard.request.search</field>
        <field name="model">mcp.guard.request</field>
        <field name="arch" type="xml">
            <search>
                <field name="name" />
                <field name="token" />
                <field name="model" />
                <field name="method" />
                <field name="agent_user_id" />
                <separator />
                <filter
                    name="pending"
                    string="Pending Approval"
                    domain="[('state','=','pending')]"
                />
                <filter
                    name="approved"
                    string="Approved"
                    domain="[('state','=','approved')]"
                />
                <filter
                    name="applied"
                    string="Applied"
                    domain="[('state','in',('applied','auto_applied'))]"
                />
                <filter
                    name="denied"
                    string="Denied/Rejected"
                    domain="[('state','in',('denied','rejected'))]"
                />
                <filter
                    name="failed"
                    string="Failed"
                    domain="[('state','=','failed')]"
                />
                <group string="Group By">
                    <filter
                        name="group_state"
                        string="State"
                        context="{'group_by':'state'}"
                    />
                    <filter
                        name="group_agent"
                        string="Agent"
                        context="{'group_by':'agent_user_id'}"
                    />
                    <filter
                        name="group_model"
                        string="Model"
                        context="{'group_by':'model'}"
                    />
                    <filter
                        name="group_method"
                        string="Method"
                        context="{'group_by':'method'}"
                    />
                </group>
            </search>
        </field>
    </record>

    <record id="mcp_guard_request_view_form" model="ir.ui.view">
        <field name="name">mcp.guard.request.form</field>
        <field name="model">mcp.guard.request</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button
                        name="action_approve"
                        type="object"
                        string="Approve"
                        class="oe_highlight"
                        attrs="{'invisible': [('state','!=','pending')]}"
                        groups="odoo_mcp_guard.group_mcp_guard_reviewer"
                    />
                    <button
                        name="action_reject"
                        type="object"
                        string="Reject"
                        attrs="{'invisible': [('state','!=','pending')]}"
                        groups="odoo_mcp_guard.group_mcp_guard_reviewer"
                    />
                    <button
                        name="action_replay"
                        type="object"
                        string="Replay Now"
                        attrs="{'invisible': [('state','!=','approved')]}"
                        groups="odoo_mcp_guard.group_mcp_guard_reviewer"
                    />
                    <field
                        name="state"
                        widget="statusbar"
                        statusbar_visible="pending,approved,applied"
                    />
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="agent_user_id" />
                            <field name="model" />
                            <field name="method" />
                            <field name="mode_at_call" />
                            <field name="token" />
                        </group>
                        <group>
                            <field name="approver_id" />
                            <field name="approved_at" />
                            <field name="replay_attempts" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Call">
                            <group>
                                <field
                                    name="record_ids_json"
                                    widget="text"
                                    readonly="1"
                                />
                                <field name="args_json" widget="text" readonly="1" />
                                <field name="kwargs_json" widget="text" readonly="1" />
                            </group>
                        </page>
                        <page string="Field Changes">
                            <field name="change_ids" readonly="1">
                                <tree>
                                    <field name="operation" />
                                    <field name="model" />
                                    <field name="res_id" />
                                    <field name="field" />
                                    <field name="old_value_json" />
                                    <field name="new_value_json" />
                                </tree>
                            </field>
                        </page>
                        <page string="Result / Error">
                            <group>
                                <field name="result_json" widget="text" readonly="1" />
                                <field name="error" widget="text" readonly="1" />
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" />
                    <field name="activity_ids" />
                    <field name="message_ids" />
                </div>
            </form>
        </field>
    </record>

    <record id="mcp_guard_request_view_kanban" model="ir.ui.view">
        <field name="name">mcp.guard.request.kanban</field>
        <field name="model">mcp.guard.request</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_small_column">
                <field name="name" />
                <field name="model" />
                <field name="method" />
                <field name="agent_user_id" />
                <field name="state" />
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <strong>
                                    <field name="name" />
                                </strong>
                            </div>
                            <div><field name="model" />.<field name="method" /></div>
                            <div class="text-muted">
                                <field name="agent_user_id" />
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="action_mcp_guard_request" model="ir.actions.act_window">
        <field name="name">MCP Guard Requests</field>
        <field name="res_model">mcp.guard.request</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="context">{'search_default_pending': 1}</field>
    </record>
</odoo>
