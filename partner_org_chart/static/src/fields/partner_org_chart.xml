<?xml version="1.0" encoding="UTF-8" ?>
<templates id="template" xml:space="preserve">

    <t t-name="partner_org_chart.partner_org_chart" owl="1">
        <div t-if="data" class="o_org_chart_wrap">
            <ul class="o_org_chart">
                <t t-call="partner_org_chart.org_chart_node">
                    <t t-set="data" t-value="data" />
                    <t t-set="child_ids" t-value="child_ids" />
                </t>
            </ul>
            <p class="o_org_chart_note">
                <i class="fa fa-globe me-1" />
                A contact shown with an email address is a registered website user.
            </p>
        </div>
    </t>

    <t t-name="partner_org_chart.org_chart_node" owl="1">
        <li class="o_org_chart_node">
            <div
                t-attf-class="o_org_chart_card #{data.is_self ? 'o_is_self' : ''} #{!data.active ? 'o_inactive' : ''}"
                t-on-click="() => this._onPartnerRedirect(data.id)"
            >
                <span
                    class="o_org_chart_avatar"
                    t-attf-style="background-image:url('/web/image/res.partner/{{data.id}}/avatar_128/')"
                    t-att-title="data.name"
                />
                <div class="o_org_chart_info">
                    <span class="o_org_chart_name" t-esc="data.name" />
                    <span
                        t-if="data.partner_type"
                        class="o_org_chart_type"
                        t-esc="data.partner_type"
                    />
                    <span
                        t-if="data.login"
                        class="o_org_chart_login"
                        t-att-title="data.login"
                    >
                        <i class="fa fa-globe me-1" />
                        <span t-esc="data.login" />
                    </span>
                </div>
                <div class="o_org_chart_actions" t-on-click.stop="() => {}">
                    <select
                        t-if="data.can_set_role"
                        class="o_org_chart_role form-select form-select-sm"
                        t-on-change="(ev) => this._onChangeRole(data.id, ev.target.value)"
                    >
                        <option
                            value=""
                            t-att-selected="!data.website_role_id"
                        >—</option>
                        <t t-foreach="this.available_roles" t-as="role" t-key="role.id">
                            <option
                                t-att-value="role.id"
                                t-att-selected="role.id === data.website_role_id"
                                t-esc="role.name"
                            />
                        </t>
                    </select>
                    <button
                        t-if="data.active"
                        type="button"
                        class="btn btn-link btn-sm p-0 o_org_chart_toggle text-success"
                        title="Archive"
                        t-on-click="() => this._onToggleActive(data.id)"
                    >
                        <i class="fa fa-toggle-on" />
                    </button>
                    <button
                        t-else=""
                        type="button"
                        class="btn btn-link btn-sm p-0 o_org_chart_toggle text-muted"
                        title="Restore"
                        t-on-click="() => this._onToggleActive(data.id)"
                    >
                        <i class="fa fa-toggle-off" />
                    </button>
                </div>
            </div>
            <ul t-if="child_ids.length" class="o_org_chart_children">
                <t t-foreach="child_ids" t-as="child" t-key="child.data.id">
                    <t t-call="partner_org_chart.org_chart_node">
                        <t t-set="data" t-value="child.data" />
                        <t t-set="child_ids" t-value="child.child_ids" />
                    </t>
                </t>
            </ul>
        </li>
    </t>

</templates>
