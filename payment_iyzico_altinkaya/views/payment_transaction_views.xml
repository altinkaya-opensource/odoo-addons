<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="payment_transaction_form" model="ir.ui.view">
        <field name="name">iyzico Transaction Form</field>
        <field name="model">payment.transaction</field>
        <field name="inherit_id" ref="payment.payment_transaction_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='provider_reference']" position="after">
                <label for="iyzico_installment_fee" />
                <div name="iyzico_installment_fee_div" class="d-flex">
                    <field name="iyzico_installment_fee" class="me-2" />
                    <field name="iyzico_commission_currency_id" />
                </div>
            </xpath>
        </field>
    </record>
</odoo>
