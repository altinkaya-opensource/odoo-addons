<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Customer-facing label on 50x50 mm single-up stock: product code,
         name, website and GS1 QR - no lot/qty. One label per product.
         Name lines wrap at 17 chars so they stay left of the QR column. -->
    <template id="product_external_label">
        <t t-translation="off">
            <t
                t-set="printer_type"
                t-value="docs.env.ref('product_label_print.label_product_product_external').printing_printer_id.type"
            />
            <t t-if="printer_type == 'GODEX'">
^Q50,3
^W50
^H10
^S5
^AT
^C1
^R0
~Q+0
^O0
^D0
^E15
~R255
^XSET,ROTATION,0
<t t-foreach="docs" t-as="p">
<t t-set="lines" t-value="p.label_name_lines(30, 3)" />
<t
                t-set="gs1_url"
                t-value="p.barcode and p.env['gs1.digital.link'].build_product_link(p.barcode)"
            />
^L
R6,6,395,394,3,3
AT,35,23,36,40,0,0E,0,0,<t t-out="Markup(p.default_code or '')" />
Lo,33,76,379,79
AT,35,94,22,22,0,0E,0,0,<t t-out="Markup(lines[0] if lines else '')" />
<t t-if="len(lines) > 1">AT,35,125,22,22,0,0E,0,0,<t t-out="Markup(lines[1])" /></t>
<t t-if="len(lines) > 2">AT,35,156,22,22,0,0E,0,0,<t t-out="Markup(lines[2])" /></t>
AT,24,356,19,19,0,0E,0,0,www.altinkaya.com
<t t-if="gs1_url">W227,228,3,2,M,8,5,<t t-out="len(gs1_url)" />,0
<t t-out="Markup(gs1_url)" /></t>
^P1
E
</t>
</t>
            <t t-if="printer_type == 'GODEX300'">
^Q50,3
^W50
^H10
^S5
^AT
^C1
^R0
~Q+0
^O0
^D0
^E15
~R255
^XSET,ROTATION,0
<t t-foreach="docs" t-as="p">
<t t-set="lines" t-value="p.label_name_lines(30, 3)" />
<t
                t-set="gs1_url"
                t-value="p.barcode and p.env['gs1.digital.link'].build_product_link(p.barcode)"
            />
^L
R9,9,592,591,4,4
AT,52,34,54,60,0,0E,0,0,<t t-out="Markup(p.default_code or '')" />
Lo,50,114,568,118
AT,52,141,33,33,0,0E,0,0,<t t-out="Markup(lines[0] if lines else '')" />
<t t-if="len(lines) > 1">AT,52,188,33,33,0,0E,0,0,<t t-out="Markup(lines[1])" /></t>
<t t-if="len(lines) > 2">AT,52,235,33,33,0,0E,0,0,<t t-out="Markup(lines[2])" /></t>
AT,36,534,28,28,0,0E,0,0,www.altinkaya.com
<t t-if="gs1_url">W340,342,3,2,M,8,7,<t t-out="len(gs1_url)" />,0
<t t-out="Markup(gs1_url)" /></t>
^P1
E
</t>
</t>
        </t>
    </template>
</odoo>
