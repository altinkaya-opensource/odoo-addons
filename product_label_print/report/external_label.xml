<t t-if="len(lines2) > 1">AT,445,126,28,32,0,0E,0,0,<t t-out="Markup(lines2[1])" /></t>
<t t-if="len(lines2) > 2">AT,445,158,28,32,0,0E,0,0,<t t-out="Markup(lines2[2])" /></t>
Y438,302,tek_cicek
AT,438,349,24,21,0,0E,0,0,www.altinkaya.com
<t t-if="gs1_url2">W622,206,3,2,Q,8,5,<t t-out="len(gs1_url2)" />,0
<t t-out="Markup(gs1_url2)" /></t>
</t>
^P1
E
</t>
</t>
