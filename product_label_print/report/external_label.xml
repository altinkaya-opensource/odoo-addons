<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Showroom label on 50x50 mm single-up stock: product code,
         name, website and GS1 QR - no lot/qty. One label per product.
         Name lines wrap at 30 chars so they stay above the QR column. -->
    <template id="product_external_label">
        <t t-translation="off">
            <t
                t-set="printer_type"
                t-value="docs.env.ref('product_label_print.label_product_product_external').printing_printer_id.type"
            />
            <t t-set="label_count" t-value="len(docs)" />
            <t t-if="printer_type == 'GODEX'">
^Q50,3
^W<t t-out="104 if label_count > 1 else 50" />
^H10
^S5
^AT
^C1
^R0
~Q+0
^O0
^D0
^E15
~R255
^XSET,ROTATION,0
<t t-foreach="range(0, label_count, 2)" t-as="label_index">
<t t-set="p" t-value="docs[label_index]" />
<t
                t-set="p2"
                t-value="docs[label_index + 1] if label_index + 1 &lt; label_count else False"
            />
<t t-set="lines" t-value="p.label_name_lines(30, 3)" />
<t
                t-set="gs1_url"
                t-value="p.barcode and p.env['gs1.digital.link'].build_product_link(p.barcode)"
            />
^L
AT,14,12,51,49,0,0E,0,0,<t t-out="Markup(p.default_code or '')" />
Lo,21,69,367,72
AT,30,94,28,32,0,0E,0,0,<t t-out="Markup(lines[0] if lines else '')" />
<t t-if="len(lines) > 1">AT,30,126,28,32,0,0E,0,0,<t t-out="Markup(lines[1])" /></t>
<t t-if="len(lines) > 2">AT,30,158,28,32,0,0E,0,0,<t t-out="Markup(lines[2])" /></t>
Y23,302,tek_cicek
AT,23,349,24,21,0,0E,0,0,www.altinkaya.com
<t t-if="gs1_url">W207,206,3,2,Q,8,5,<t t-out="len(gs1_url)" />,0
<t t-out="Markup(gs1_url)" /></t>
<t t-if="p2">
<t t-set="lines2" t-value="p2.label_name_lines(30, 3)" />
<t
                t-set="gs1_url2"
                t-value="p2.barcode and p2.env['gs1.digital.link'].build_product_link(p2.barcode)"
            />
