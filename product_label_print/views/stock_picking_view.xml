<?xml version="1.0" encoding="utf-8" ?>
<odoo>

       <record id="stock_move_tree_print_product_label" model="ir.ui.view">
       		<field name="name">stock.move.tree.inherit.print_product_label</field>
          	<field name="model">stock.picking</field>
          	<field name="inherit_id" ref="stock.view_picking_form" />
          	<field name="arch" type="xml">
                	<xpath
        expr="//field[@name='move_ids_without_package']//field[@name='product_id']"
        position="after"
      >
       						<button
          name="action_print_product_label"
          type="object"
          icon="fa-barcode"
          title="Print Barcode"
        />
                  	</xpath>
          	</field>
       </record>


</odoo>
