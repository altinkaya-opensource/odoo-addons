<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <!-- Product Export Wizard Form View -->
    <record id="view_trendyol_product_export_wizard_form" model="ir.ui.view">
        <field name="name">trendyol.product.export.wizard.form</field>
        <field name="model">trendyol.product.export.wizard</field>
        <field name="arch" type="xml">
            <form string="Export Products to Trendyol">
                <group>
                    <group>
                        <field name="backend_id" />
                        <field name="trendyol_category_id" />
                        <field name="trendyol_brand_id" />
                    </group>
                    <group>
                        <field name="odoo_category_id" />
                        <field
                            name="odoo_product_search"
                            placeholder="Yazdıktan sonra Enter tuşuna basın"
                        />
                        <field name="vat_rate" />
                        <field name="skip_existing" />
                    </group>
                </group>
                <div attrs="{'invisible': [('trendyol_category_id', '=', False)]}">
                    <button
                        name="action_sync_category_attributes"
                        string="Özellikleri Getir"
                        type="object"
                        class="btn-secondary mb-2"
                    />
                    <field name="attribute_line_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="category_attribute_id" invisible="1" />
                            <field name="name" />
                            <field name="required" />
                            <field name="value_id" />
                            <field name="allow_custom" invisible="1" />
                            <field
                                name="custom_value"
                                attrs="{'invisible': [('allow_custom', '=', False)]}"
                            />
                        </tree>
                    </field>
                </div>
                <div string="Products">
                    <field name="product_ids" nolabel="1">
                        <tree>
                            <field name="default_code" />
                            <field name="name" />
                            <field name="categ_id" />
                            <field name="barcode" />
                            <field name="list_price" />
                            <field
                                name="image_1920"
                                widget="image"
                                options="{'size': [40, 40]}"
                            />
                        </tree>
                    </field>
                </div>
                <footer>
                    <button
                        name="action_create_bindings"
                        string="Trendyol'a Aktar"
                        type="object"
                        class="btn-primary"
                    />
                    <button string="Cancel" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>

    <!-- Product Export Wizard Action -->
    <record id="action_trendyol_product_export_wizard" model="ir.actions.act_window">
        <field name="name">Export to Trendyol</field>
        <field name="res_model">trendyol.product.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_product" />
        <field name="binding_view_types">list,form</field>
    </record>

    <!-- Also bind to product.template -->
    <record
        id="action_trendyol_product_export_wizard_template"
        model="ir.actions.act_window"
    >
        <field name="name">Trendyol'a aktar</field>
        <field name="res_model">trendyol.product.export.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="product.model_product_template" />
        <field name="binding_view_types">list,form</field>
    </record>
</odoo>
