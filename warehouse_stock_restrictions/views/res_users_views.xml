<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record model="ir.ui.view" id="view_location_security_users_form">
        <field name="name">location_security.users.form</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form" />
        <field name="arch" type="xml">
            <notebook>
                <page string="Warehouse Stock Restrictions">
                    <group>
                        <field name="restrict_locations" />
                    </group>
                    <group
                        string="Allowed Warehouses"
                        attrs="{'invisible': [('restrict_locations', '=', False)]}"
                    >
                        <group>
                            <field
                                name="allowed_warehouse_ids"
                                widget="many2many_tags"
                            />
                        </group>
                    </group>
                </page>
            </notebook>
        </field>
    </record>
</odoo>
