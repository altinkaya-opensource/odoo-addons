#. module: web_translate_ai
#: model_terms:ir.ui.view,arch_db:web_translate_ai.view_ai_translation_config_form
msgid ""
"<span class=\"text-muted\">\n"
"                                1. Create a glossary with source and target languages.<br/>\n"
"                                2. Add entries to the created glossary.<br/>\n"
"                                3. The glossary terms will be injected into the AI prompt automatically during translation.\n"
"                            </span>"
msgstr ""
