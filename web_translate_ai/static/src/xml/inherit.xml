<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-inherit="web.TranslationDialog" t-inherit-mode="extension" owl="1">
        <!-- Compact toolbar with Translate All + Copy actions -->
        <xpath expr="//div[hasclass('o_translation_dialog')]" position="before">
            <div t-if="props.ai_enabled" class="oe_translate_ai_toolbar">
                <button
                    class="btn btn-primary btn-sm oe_translate_ai_all_btn"
                    t-on-click="onClickTranslateAll"
                    title="Translate all languages in one batch"
                >
                    <span>
                        <i class="fa fa-globe" />
                        Translate All
                    </span>
                </button>

                <button
                    class="btn btn-outline-secondary btn-sm"
                    t-on-click="onClickCopyEnglish"
                    title="Copy English to all languages"
                >
                    <i class="fa fa-copy" />
                    EN
                </button>

                <button
                    class="btn btn-outline-secondary btn-sm"
                    t-on-click="onClickCopyTurkish"
                    title="Copy Turkish to all languages"
                >
                    <i class="fa fa-copy" />
                    TR
                </button>
            </div>
        </xpath>

        <!-- Per-language translate button inside translation div -->
        <xpath expr="//div[hasclass('translation')]" position="inside">
            <button
                t-if="props.ai_enabled"
                t-att-title="term.base_lang + ' -> ' + term.lang"
                class="btn btn-outline-primary btn-sm oe_translate_ai_btn"
                t-att-data-field-type="props.isText ? 'textarea' : 'input'"
                t-att-data-lang="term.lang"
                t-att-data-base-lang="term.base_lang"
                t-att-data-is-user-lang="term.lang === props.user_lang ? 'true' : 'false'"
                t-on-click="onClickTranslate"
            >
                <i class="fa fa-globe" />
            </button>
        </xpath>
    </t>
</templates>
