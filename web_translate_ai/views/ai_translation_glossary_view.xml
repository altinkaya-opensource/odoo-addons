<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_ai_translation_glossary_form" model="ir.ui.view">
        <field name="name">ai.translation.glossary.form</field>
        <field name="model">ai.translation.glossary</field>
        <field name="arch" type="xml">
            <form string="AI Translation Glossary">
                <sheet>
                    <group>
                        <field name="source_lang_id" />
                        <field name="target_lang_id" />
                        <field name="ai_translation_config_id" readonly="1" />
                    </group>
                    <notebook>
                        <page string="Entries">
                            <field
                                name="line_ids"
                                widget="one2many_list"
                                context="{'default_ai_translation_glossary_id': active_id}"
                            >
                                <tree editable="bottom">
                                    <field name="source_term" />
                                    <field name="target_term" />
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ai_translation_glossary_tree" model="ir.ui.view">
        <field name="name">ai.translation.glossary.tree</field>
        <field name="model">ai.translation.glossary</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="source_lang_id" />
                <field name="target_lang_id" />
            </tree>
        </field>
    </record>
</odoo>
