<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="res_company_ai_translation_form_inherit" model="ir.ui.view">
        <field name="name">res.company.ai.translation.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="ai_translation" string="AI Translation Config">
                    <group>
                        <field name="ai_translation_config_id" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
