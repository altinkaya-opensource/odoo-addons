<?xml version="1.0" encoding="utf-8" ?>
<odoo>
<template
    id="ChatToCompany"
    name="Chat With Company"
    inherit_id="web.frontend_layout"
>
    <xpath expr="//header[@id='top']" position="before">
        <a
            t-attf-href="https://wa.me/#{website.mobile_number}"
            class="cy_whatsapp_web"
            target="_blank"
            rel="noopener"
        >
            <i class="fa fa-whatsapp cy-icon" />
            <span class="cy-whatsapp-text">Chat with us</span>
        </a>
    </xpath>
</template>
</odoo>
