<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="zkteco_device_form" model="ir.ui.view">
        <field name="name">zkteco.device.form</field>
        <field name="model">zkteco.device</field>
        <field name="arch" type="xml">
            <form string="ZKTeco Device">
                <header>
                    <button
            name="action_test_connection"
            type="object"
            string="Test Connection"
            class="oe_highlight"
            groups="hr_attendance.group_hr_attendance_manager"
          />
                    <button
            name="action_get_attendance"
            type="object"
            string="Get Attendance"
            groups="hr_attendance.group_hr_attendance_manager"
          />
                    <field name="state" widget="statusbar" />
                </header>
                <sheet>
                    <div name="button_box" class="oe_button_box">
                        <button
              name="action_open_log"
              string="Logs"
              type="object"
              class="oe_stat_button"
              icon="fa-bars"
            />
                    </div>
                    <group>
                        <group>
                            <field name="name" />
                            <field name="ip_address" />
                            <field name="port" />
                            <field name="password" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="zkteco_device_tree" model="ir.ui.view">
        <field name="name">zkteco.device.tree</field>
        <field name="model">zkteco.device</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name" />
                <field name="ip_address" />
                <field name="port" />
            </tree>
        </field>
    </record>

    <record id="zkteco_device_action" model="ir.actions.act_window">
        <field name="name">ZKTeco Devices</field>
        <field name="res_model">zkteco.device</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="zkteco_device_tree" />
    </record>

    <menuitem
    id="zkteco_device_menu"
    name="ZKTeco Devices"
    parent="hr.menu_human_resources_configuration"
    action="zkteco_device_action"
    groups="hr_attendance.group_hr_attendance_manager"
  />

</odoo>
